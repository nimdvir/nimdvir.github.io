  "appropriateWritingStyleSample": true,
  "completeness": {
    "firstTextBlock": "ורד פלדמן ועופרי פרישקולניק, שתי שחקניות עסוקות, מדגמנות בימים אלה את המרחק בין הטלוויזיה לבין המציאות. בעוד שבדרמה הקומית \"הצרות שלי עם נשים\" (ימי שני, 22:25, ערוץ 10), השתיים מגלמות רווקות קשות יום, במציאות מדובר בשתיים כל כך מאוהבות עד שזה כואב.",
    "lastTextBlock": "עופרי: \"באמת? תודה. אני משתדלת לשווק את עצמי בצורה חיננית\".",
