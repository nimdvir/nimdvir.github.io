{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Optimize images",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "optimize:images"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload all images to Cloudinary",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "cloudinary:upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "Upload current image to Cloudinary",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/cloudinary-upload.mjs",
        "${file}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Local deploy preview",
      "type": "shell",
      "command": "npm run build && npm run preview -- --host --port 4321",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
