---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { asset } from "../utils/asset";
import { socialLinks } from "../data/profile";

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site!;
const personId = new URL("#person", siteUrl).href;
const siteName = "Nim Dvir";

const {
  title = siteName,
  description = "Research, teaching, projects, and writing by Nim Dvir, a lecturer at the University at Albany.",
  image = "/images/nim-dvir-cce.jpg",
  imageAlt,
  publishedTime,
  type = "website",
  noindex = false,
  fullTitle,
  canonicalPath = Astro.url.pathname,
  profilePage = false,
  structuredData = [],
  breadcrumbs = [],
  particles = "subtle",
} = Astro.props;

// Search results show about 60 characters of a title, so long titles drop
// the site-name suffix instead of losing their own words.
const pageTitle =
  fullTitle ??
  (title === siteName
    ? title
    : title.length > 50
      ? title
      : `${title} | ${siteName}`);
// Search snippets and link previews show about 160 characters. Long summaries
// are cut at a word boundary for the meta tags; structured data keeps them whole.
const metaDescription = (() => {
  const text = String(description).replace(/\s+/g, " ").trim();
  if (text.length <= 160) return text;
  const cut = text.slice(0, 157);
  return `${cut.slice(0, cut.lastIndexOf(" ")).replace(/[\s,;:.]+$/, "")}…`;
})();
const ogImageAlt =
  imageAlt ??
  (image === "/images/nim-dvir-cce.jpg" ? "Portrait of Nim Dvir" : title);
const canonicalURL = new URL(canonicalPath, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

// JSON-LD structured data
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": new URL("#website", siteUrl).href,
  name: siteName,
  url: siteUrl,
  description:
    "Research, teaching, projects, and writing by Nim Dvir, a lecturer at the University at Albany.",
  inLanguage: "en",
  publisher: { "@id": personId },
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  alternateName: "Nimrod Dvir",
  name: "Nim Dvir",
  givenName: "Nimrod",
  familyName: "Dvir",
  honorificSuffix: "PhD",
  url: siteUrl,
  image: new URL("/images/nim-dvir-cce.jpg", siteUrl).href,
  description:
    "Lecturer in Information Systems and Business Analytics at the Massry School of Business, University at Albany (SUNY). Studies language, information engagement and decision-making; teaches databases, business analytics and programming; former journalist and UX researcher.",
  jobTitle: "Lecturer in Information Systems and Business Analytics",
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: "University at Albany, SUNY",
    url: "https://www.albany.edu",
    department: {
      "@type": "Organization",
      name: "Department of Information Systems and Business Analytics, Massry School of Business",
      url: "https://www.albany.edu/business",
    },
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University at Albany, SUNY" },
    { "@type": "CollegeOrUniversity", name: "Baruch College, City University of New York" },
    { "@type": "CollegeOrUniversity", name: "New York University" },
    { "@type": "CollegeOrUniversity", name: "Open University of Israel" },
  ],
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "degree",
    name: "Ph.D. in Computer and Information Science",
  },
  knowsAbout: [
    "Information Systems",
    "Business Analytics",
    "Databases",
    "UX Research",
    "Human-Computer Interaction",
    "Information Engagement",
    "Computational Linguistics",
    "Natural Language Processing",
    "Artificial Intelligence in Education",
    "Journalism",
  ],
  knowsLanguage: ["en", "he"],
  sameAs: socialLinks
    .map((link) => link.href)
    .filter((href) => href.startsWith("https://") && !href.startsWith(String(siteUrl).replace(/\/$/, ""))),
};
const pageSchemas = [...structuredData];
if (profilePage)
  pageSchemas.push({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalURL}#profile`,
    url: canonicalURL,
    name: pageTitle,
    mainEntity: personSchema,
  });
if (breadcrumbs.length)
  pageSchemas.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.path, siteUrl).href,
    })),
  });
const jsonLd = (data) => JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="MlEkFKPoB9X-ma4kqEaSQp__q2TJgYxF_gGrpm1l0Oc"
    />
    <link rel="icon" type="image/png" href={`${base}favicon.png?v=20261001`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="theme-color" content="#141c33" />
    <script is:inline src={asset("/js/theme-init.js")}></script>
    <link rel="stylesheet" href={asset("/styles/site.css")} />
    <meta name="author" content="Nim Dvir" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && <meta property="article:author" content={new URL("/cv/", siteUrl).href} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={jsonLd(websiteSchema)} />
    <script type="application/ld+json" set:html={jsonLd(personSchema)} />
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonLd(schema)} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nim Dvir: blog and news"
      href={new URL("/rss.xml", siteUrl).href}
    />
    <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", siteUrl).href} />
    <slot name="head" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0PZ8NW81X4"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-0PZ8NW81X4");
    </script>
  </head>
  <body data-particles={particles}>
    <div class="bg-particles" id="particles-js" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content" target="_self">
      Skip to content
    </a>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Dark masthead (light theme): a band from the top of the page to the
      // bottom of the page intro. The nav turns light once you scroll past it.
      (() => {
        const root = document.documentElement;
        const header = document.querySelector(".site-header");
        const main = document.querySelector("main");
        const intro = document.querySelector(
          "main > .home-top:first-child, main > .page-intro:first-child",
        );
        if (!header || !main) return;
        let bottom = 0;
        const past = () =>
          root.classList.toggle(
            "past-masthead",
            scrollY > Math.max(1, bottom - header.offsetHeight - 8),
          );
        const place = () => {
          const gap = intro ? parseFloat(getComputedStyle(intro).marginBottom) || 0 : 0;
          bottom = intro
            ? intro.getBoundingClientRect().bottom + scrollY + gap
            : header.offsetHeight;
          root.style.setProperty("--masthead-h", `${bottom}px`);
          root.style.setProperty(
            "--main-top",
            `${main.getBoundingClientRect().top + scrollY}px`,
          );
          past();
        };
        place();
        root.classList.add("has-masthead");
        addEventListener("scroll", past, { passive: true });
        addEventListener("load", place);
        new ResizeObserver(place).observe(document.body);
      })();
    </script>
    <script src={asset("/js/site.js")} is:inline defer></script>
    <script src={asset("/js/particles.js")} is:inline defer></script>
    <script src={asset("/js/particles-bg.js")} is:inline defer></script>
  </body>
</html>
