---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles, articleByline, articleDate } from "../utils/articles";

const articles = await getArticles();
const latest = articles.filter((a) => !a.data.thirdPartyCoverage).slice(0, 6);
const coverage = articles.filter((a) => a.data.thirdPartyCoverage);
---

<Layout
  title="Media"
  description="Television appearances, coverage, and a selection from Nim Dvir's journalism archive of interviews, columns, and features."
>
  <header class="page-intro">
    <h1>Media</h1>
    <p class="lede">
      I worked as a journalist and editor in Israel and New York before moving
      into academia. The full archive of translated articles is on the{" "}
      <a href="/articles/">Articles</a> page. This page collects a selection,
      television appearances, and pieces other journalists wrote about me.
    </p>
  </header>

  <section class="section" style="border-top:0">
    <div class="section-head">
      <h2>From the archive</h2>
      <a href="/articles/">All {articles.length} articles ↗</a>
    </div>
    <div class="grid-3 article-grid">
      {latest.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Television</h2>
    <div class="grid-2">
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/0cPdG0gx3fM"
            title="Nim Dvir on Israeli Educational Television, Profile, 2016"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>Profile · Israeli Educational Television</h3>
        <p class="small">
          September 26, 2016 ·{" "}
          <a href="https://youtu.be/0cPdG0gx3fM">Watch on YouTube ↗</a>
        </p>
      </article>
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/-ZLoYBUchmI"
            title="Nim Dvir at The Dictator press conference with Sacha Baron Cohen, 2012"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>The Dictator press conference</h3>
        <p class="small">
          May 8, 2012 ·{" "}
          <a href="https://youtu.be/-ZLoYBUchmI">Watch on YouTube ↗</a>
        </p>
      </article>
    </div>
  </section>

  {coverage.length > 0 && (
    <section class="split-section">
      <div>
        <h2>Coverage</h2>
        <p class="small">
          Pieces by other journalists in which I am the subject, a source, or
          the photographer. Translated with their original bylines.
        </p>
      </div>
      <ul class="reading-list">
        {coverage.map((a) => (
          <li>
            <h3>
              <a href={`/articles/${a.slug}/`}>{a.data.title}</a>
            </h3>
            <p>
              {articleByline(a)} · {a.data.source} · {articleDate(a.data.date)}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
