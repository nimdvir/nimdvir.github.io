---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const interviews = (await getCollection("interviews")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const additional = [
  [
    "Sandra Oh & Jodie Comer",
    "Enemies, A Love Story · Israel Hayom · April 2019",
    "https://www.israelhayom.co.il/magazine/shishabat/article/9324631",
  ],
  [
    "Karim Rashid",
    "Karim Rashid’s Utopia · AT Magazine · April 2017",
    "https://bit.ly/ndvirrashid",
  ],
  [
    "Gila Gamliel",
    "Interview · AT Magazine · November 2017",
    "https://bit.ly/ndvirgilagamliel",
  ],
];
---

<Layout
  title="Media & Interviews"
  description="Journalism, interviews, and media appearances by Nim Dvir, including conversations on culture, design, and society."
>
  <header class="page-intro">
    <p class="eyebrow">Media / Conversations</p>
    <h1>
      Listening closely.
      <br />
      <span class="gradient-text">Telling the story.</span>
    </h1>
    <p class="lede">
      Before academia, I worked as an editor and journalist in Israel and New
      York. Interviewing people, understanding context, and translating complex
      ideas remain central to my work.
    </p>
  </header>
  <section class="section" style="border-top:0">
    <div class="section-head">
      <h2>Selected interviews.</h2>
    </div>
    <div class="grid-3">
      {interviews.map((i) => (
        <article class="card">
          <a
            class="card-visual"
            href={`/interviews/${i.slug}/`}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={i.data.image}
              alt=""
              loading="lazy"
              width="640"
              height="400"
            />
          </a>
          <div class="card-body">
            <p class="eyebrow">
              {i.data.source} · {i.data.date}
            </p>
            <h3>
              <a href={`/interviews/${i.slug}/`}>
                {i.data.interviewee || i.data.title}
              </a>
            </h3>
            <p>{i.data.summary}</p>
            <a class="text-link" href={`/interviews/${i.slug}/`}>
              Read the interview ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">From the archive</p>
      <h2>More conversations.</h2>
    </div>
    <ul class="reading-list">
      {additional.map(([name, description, url]) => (
        <li>
          <h3>
            <a href={url}>{name} ↗</a>
          </h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="section">
    <h2>On camera.</h2>
    <div class="grid-2">
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/0cPdG0gx3fM"
            title="Nim Dvir on Israeli Educational Television, Profile, 2016"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>Profile · Israeli Educational Television</h3>
        <p class="small">
          September 26, 2016 ·{" "}
          <a href="https://youtu.be/0cPdG0gx3fM">Watch on YouTube ↗</a>
        </p>
      </article>
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/-ZLoYBUchmI"
            title="Nim Dvir at The Dictator press conference with Sacha Baron Cohen, 2012"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>The Dictator press conference</h3>
        <p class="small">
          May 8, 2012 ·{" "}
          <a href="https://youtu.be/-ZLoYBUchmI">Watch on YouTube ↗</a>
        </p>
      </article>
    </div>
  </section>
  <aside class="highlight-panel">
    <h2>For speaking and media inquiries</h2>
    <p>
      UX, human-centered AI, information engagement, and technology in
      education.
    </p>
    <a class="text-link" href="mailto:ndvir@albany.edu">
      Contact Nim ↗
    </a>
  </aside>
</Layout>
