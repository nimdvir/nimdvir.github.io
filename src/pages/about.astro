---
import Layout from "../layouts/Layout.astro";
import { cvUrl } from "../data/profile";
const career = [
  [
    "2025–present",
    "Lecturer",
    "Information Systems and Business Analytics, Massry School of Business, University at Albany",
  ],
  [
    "2021–2025",
    "Visiting Assistant Professor",
    "Massry School of Business, University at Albany",
  ],
  [
    "2016–present",
    "Adjunct Faculty",
    "College of Emergency Preparedness, Homeland Security, and Cybersecurity, University at Albany",
  ],
  ["2019–2021", "Adjunct Instructor", "SUNY Online"],
  [
    "2019–2020",
    "Visiting Assistant Professor",
    "Pratt Institute, New York. Digital product design and content strategy.",
  ],
  ["2017", "Visiting Lecturer", "Academic College of Tel Aviv-Yaffo"],
  ["2015–2019", "Research and Teaching Assistant", "University at Albany"],
  [
    "2014–2015",
    "UX Researcher & Development Manager",
    "ClaimFame. Online learning and product development for entertainment professionals.",
  ],
  [
    "2012–2014",
    "UX Researcher & Product Manager",
    "WZO, New York. CRM systems and digital services.",
  ],
  [
    "2009–2011",
    "Chief Digital Content Strategist / Culture Editor",
    "Ma’ariv Media Group, Tel Aviv",
  ],
  [
    "2005–2009",
    "Deputy Editor, Culture Editor & U.S. Correspondent",
    "Pnai Plus, Yedioth Ahronoth Group",
  ],
];
const education = [
  [
    "2022",
    "PhD, Computer and Information Science",
    "University at Albany, SUNY",
    "Human-Computer Interaction and Management Information Systems. Dissertation: Sticky Words.",
  ],
  [
    "2014",
    "MBA, Marketing & Information Systems",
    "Baruch College, CUNY",
    "Summa cum laude",
  ],
  [
    "2011",
    "BA, Political Science & Journalism",
    "New York University",
    "Summa cum laude · Presidential Honor Program",
  ],
  ["2009", "BA, Social Sciences & Humanities", "Open University of Israel", ""],
];
---

<Layout
  title="About"
  description="Nim Dvir’s background in research, teaching, journalism, and product development."
>
  <header class="page-intro">
    <h1>About</h1>
  </header>
  <section class="split-section" style="border-top:0;padding-top:0">
    <div>
      <img
        class="about-photo"
        src="/images/nim-dvir-cce.jpg"
        alt="Nim Dvir"
        width="400"
        height="400"
      />
    </div>
    <div class="prose">
      <p>
        I’m Nimrod Dvir, but I go by Nim. I’m a lecturer at the University at
        Albany’s Massry School of Business, where I teach information systems
        and business analytics.
      </p>
      <p>
        Before academia, I worked as a journalist and editor in Israel and New
        York, and later in user research and product development. I completed my
        PhD in Computer and Information Science at UAlbany in 2022. My
        dissertation, <em>Sticky Words</em>, examined language and information
        engagement.
      </p>
      <h2>Current work</h2>
      <p>
        I’m working on{" "}
        <a href="/research/words-on-trial/">
          language in mental health treatment courts
        </a>
        , developing <a href="/teaching/#courseware">business courseware</a>,
        and teaching students to use and evaluate AI tools. I also write about
        some of that work on the <a href="/blog/">blog</a>.
      </p>
    </div>
  </section>
  <section class="split-section">
    <h2>Experience</h2>
    <ol class="timeline">
      {career.map(([date, title, org]) => (
        <li>
          <span class="date">{date}</span>
          <h3>{title}</h3>
          <p>{org}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="split-section">
    <h2>Education</h2>
    <ol class="timeline">
      {education.map(([date, title, org, note]) => (
        <li>
          <span class="date">{date}</span>
          <h3>{title}</h3>
          <p>{org}</p>
          {note && <p class="small">{note}</p>}
        </li>
      ))}
    </ol>
  </section>
  <section class="split-section">
    <h2>Awards and service</h2>
    <div class="prose">
      <ul>
        <li>
          Faculty Research Award Program, Category B, University at Albany,
          2026.
        </li>
        <li>Service Award, University at Albany, 2025.</li>
        <li>
          Distinguished Dissertation Award and Excellence in Research Project
          Award, University at Albany, 2023.
        </li>
      </ul>
      <p>
        I founded <strong>Ballad</strong>, the LGBTQ+ student organization for
        business students at the Massry School of Business, in 2024.
      </p>
      <p>
        I serve on the school’s Impact and Climate Committees and the Cengage
        Introductory Computing Thought Advisory Board. I also mentor student
        research and review papers for information systems and user experience
        conferences.
      </p>
      <div class="button-row">
        <a class="button" href={cvUrl}>
          Full CV
        </a>
        <a class="button" href="/files/Nim-Dvir-CV-2026-09.pdf">
          Download CV (PDF)
        </a>
      </div>
    </div>
  </section>
</Layout>
