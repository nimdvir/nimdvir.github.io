---
import Layout from "../layouts/Layout.astro";
import { cvUrl } from "../data/profile";
const career = [
  [
    "2025–present",
    "Lecturer",
    "Information Systems and Business Analytics, Massry School of Business, University at Albany",
  ],
  [
    "2021–2025",
    "Visiting Assistant Professor",
    "Massry School of Business, University at Albany",
  ],
  [
    "2016–present",
    "Adjunct Faculty",
    "College of Emergency Preparedness, Homeland Security, and Cybersecurity, University at Albany",
  ],
  ["2019–2021", "Adjunct Instructor", "SUNY Online"],
  [
    "2019–2020",
    "Visiting Assistant Professor",
    "Pratt Institute, New York. Digital product design and content strategy.",
  ],
  ["2017", "Visiting Lecturer", "Academic College of Tel Aviv-Yaffo"],
  ["2015–2019", "Research and Teaching Assistant", "University at Albany"],
  [
    "2014–2015",
    "UX Researcher & Development Manager",
    "ClaimFame. Online learning and product development for entertainment professionals.",
  ],
  [
    "2012–2014",
    "UX Researcher & Product Manager",
    "WZO, New York. CRM systems and digital services.",
  ],
  [
    "2009–2011",
    "Chief Digital Content Strategist / Culture Editor",
    "Ma’ariv Media Group, Tel Aviv",
  ],
  [
    "2005–2009",
    "Deputy Editor, Culture Editor & U.S. Correspondent",
    "Pnai Plus, Yedioth Ahronoth Group",
  ],
];
const education = [
  [
    "2022",
    "PhD, Computer and Information Science",
    "University at Albany, SUNY",
    "Human-Computer Interaction and Management Information Systems. Dissertation: Sticky Words.",
  ],
  [
    "2014",
    "MBA, Marketing & Information Systems",
    "Baruch College, CUNY",
    "Summa cum laude",
  ],
  [
    "2011",
    "BA, Political Science & Journalism",
    "New York University",
    "Summa cum laude · Presidential Honor Program",
  ],
  ["2009", "BA, Social Sciences & Humanities", "Open University of Israel", ""],
];
---

<Layout
  title="About"
  description="Meet Nim Dvir: UX and AI researcher, Lecturer at UAlbany, and educator connecting human behavior, business, and technology."
>
  <header class="page-intro">
    <p class="eyebrow">About Nim</p>
    <h1>
      Curious about people.
      <br />
      <span class="gradient-text">Practical about technology.</span>
    </h1>
    <p class="lede">
      I bring together research, teaching, and product thinking to make
      information and technology more useful.
    </p>
  </header>
  <section class="split-section">
    <div>
      <img
        class="about-photo"
        src="/images/nim-dvir-cce.jpg"
        alt="Nim Dvir"
        width="400"
        height="400"
      />
      <a class="button button-primary" href={cvUrl}>
        Full CV · September 2026 ↗
      </a>
    </div>
    <div class="prose">
      <h2>Hi, I’m Nim.</h2>
      <p>
        I’m Dr. Nimrod (Nim) Dvir, a Lecturer in Information Systems and
        Business Analytics at the University at Albany’s Massry School of
        Business. My work spans Human-Computer Interaction, user experience,
        artificial intelligence, natural language processing, and information
        systems.
      </p>
      <p>
        Over more than a decade in UX and AI research, I’ve combined qualitative
        and quantitative methods to study how people interpret information and
        make decisions. My PhD at UAlbany explored computational linguistics and
        information engagement. The dissertation received the university’s
        Distinguished Dissertation and Excellence in Research Awards in 2023.
      </p>
      <p>
        Before academia, I worked in product development, digital content
        strategy, and journalism. That background still shapes how I approach
        research: listen closely, ask a better question, and communicate the
        result clearly.
      </p>
      <p>
        <span class="marker">
          I want technology to help people understand, decide, and create.
        </span>
      </p>
      <p>
        Today, that means studying language in mental health treatment courts,
        developing interactive business courseware, and helping students and
        faculty use AI critically and effectively.
      </p>
    </div>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Background</p>
      <h2>
        A career across
        <br />
        disciplines.
      </h2>
    </div>
    <ol class="timeline">
      {career.map(([date, title, org]) => (
        <li>
          <span class="date">{date}</span>
          <h3>{title}</h3>
          <p>{org}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Education</p>
      <h2>
        Four degrees.
        <br />
        One curious mind.
      </h2>
    </div>
    <ol class="timeline">
      {education.map(([date, title, org, note]) => (
        <li>
          <span class="date">{date}</span>
          <h3>{title}</h3>
          <p>{org}</p>
          {note && <p class="small">{note}</p>}
        </li>
      ))}
    </ol>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Recognition</p>
      <h2>
        Research and
        <br />
        community.
      </h2>
    </div>
    <ul class="reading-list">
      <li>
        <span class="status-label">2026 · Research funding</span>
        <h3>Faculty Research Award Program, Category B</h3>
        <p>
          $3,242 to support research on language, participation, and engagement
          in mental health treatment courts.
        </p>
      </li>
      <li>
        <span class="status-label">2025 · Service</span>
        <h3>University at Albany Service Award</h3>
        <p>Recognition for student support and mentoring.</p>
      </li>
      <li>
        <span class="status-label">2023 · Scholarship</span>
        <h3>
          Distinguished Dissertation & Excellence in Research Project Awards
        </h3>
        <p>University at Albany recognition for the Sticky Words research.</p>
      </li>
    </ul>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Ways I contribute</p>
      <h2>
        Beyond the
        <br />
        classroom.
      </h2>
    </div>
    <div class="prose">
      <p>
        I founded <strong>Ballad</strong>, an LGBTQ+ organization for business
        students at the Massry School of Business, to create space for peer
        support, dialogue, and professional development.
      </p>
      <p>
        I serve on the school’s Impact and Climate Committees and the Cengage
        Introductory Computing Thought Advisory Board. I also mentor student
        research and review work for information systems and user experience
        conferences.
      </p>
      <h3>My toolkit</h3>
      <ul class="tag-list">
        {[
          "Mixed methods",
          "Experiments",
          "Interviews",
          "Usability testing",
          "Python",
          "SQL",
          "R",
          "NLP",
          "LLM evaluation",
          "Figma",
          "Content strategy",
          "AI workflows",
        ].map((t) => (
          <li>{t}</li>
        ))}
      </ul>
      <div class="button-row">
        <a class="button" href="/#contact">
          Let’s work together ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
