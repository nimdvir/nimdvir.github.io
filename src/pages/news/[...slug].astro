---
import Layout from "../../layouts/Layout.astro";
import { getNews, formatDate } from "../../utils/editorial";
export async function getStaticPaths() {
  return (await getNews())
    .filter((entry) => !entry.data.inline)
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
  type="article"
>
  <article class="editorial-article">
    <header class="editorial-article-header">
      <a class="back-link" href="/news/">
        ← All news
      </a>
      <p class="eyebrow">
        News /{" "}
        <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {entry.data.link && (
      <p>
        <a class="text-link" href={entry.data.link}>
          Related link ↗
        </a>
      </p>
    )}
    <p class="more-posts">
      <a class="text-link" href="/news/">
        More news ↗
      </a>
    </p>
  </article>
</Layout>
