---
import Layout from "../layouts/Layout.astro";
import NewsList from "../components/NewsList.astro";
import PostList from "../components/PostList.astro";
import ProfileIcon from "../components/ProfileIcon.astro";
import { getPosts, getNews } from "../utils/editorial";
import { cvUrl, socialLinks } from "../data/profile";
const [posts, news] = await Promise.all([getPosts(), getNews()]);
---

<Layout
  fullTitle="Nim Dvir | Information Systems, Research and Teaching"
  description="Nim Dvir (Nimrod Dvir) teaches information systems and business analytics at the University at Albany and studies language and information engagement."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div>
      <h1 id="home-title">Nim Dvir</h1>
      <p class="home-position">
        Lecturer in Information Systems and Business Analytics
        <br />
        Massry School of Business · University at Albany, SUNY
      </p>
      <p class="intro">
        I study how people read, interpret, and use information. I teach
        information systems, business analytics, and programming. Before
        academia, I worked in journalism and digital product development.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/about/">
          About me
        </a>
        <a class="button" href={cvUrl}>
          CV
        </a>
        <a class="button" href="/contact/">
          Email
        </a>
      </div>
      <nav class="social-links" aria-label="Professional profiles">
        {socialLinks
          .filter((l) =>
            [
              "LinkedIn",
              "Google Scholar",
              "GitHub",
              "Instagram",
              "UAlbany faculty",
            ].includes(l.label),
          )
          .map((l) => (
            <a class="button" href={l.href}>
              <ProfileIcon icon={l.icon} />
              {l.label}
            </a>
          ))}
      </nav>
    </div>
    <figure class="portrait-wrap">
      <img
        class="hero-portrait"
        src="/images/nim-dvir-cce.jpg"
        alt="Nim Dvir"
        width="800"
        height="800"
        fetchpriority="high"
      />
    </figure>
  </section>
  <div class="home-updates">
    <section aria-labelledby="home-news-heading">
      <div class="section-head">
        <h2 id="home-news-heading">News</h2>
        <a href="/news/">All news</a>
      </div>
      {news.length ? (
        <NewsList entries={news.slice(0, 3)} />
      ) : (
        <p class="small">No news yet.</p>
      )}
    </section>
    {posts.length > 0 && (
      <section aria-labelledby="latest-posts-heading">
        <div class="section-head">
          <h2 id="latest-posts-heading">Recent posts</h2>
          <a href="/blog/">All posts</a>
        </div>
        <PostList entries={posts.slice(0, 3)} compact />
      </section>
    )}
  </div>
  <section class="section" style="border-top:0">
    <h2>Current work</h2>
    <div class="grid-3">
      <article class="plain-card">
        <h3>
          <a href="/research/words-on-trial/">
            Language in mental health treatment courts
          </a>
        </h3>
        <p>
          I’m studying how legal language relates to participants’ understanding
          and engagement, in collaboration with Nevada’s Eighth Judicial
          District Court.
        </p>
      </article>
      <article class="plain-card">
        <h3>
          <a href="/teaching/#courseware">
            Using Data to Drive Business Performance
          </a>
        </h3>
        <p>
          I’m developing a textbook and interactive courseware on databases,
          SQL, and business analytics.
        </p>
        <a
          class="text-link"
          href="https://database-textbook.dimapublishing.com/"
        >
          Courseware ↗
        </a>
      </article>
      <article class="plain-card">
        <p class="small">CCE 2026 · October 21–23</p>
        <h3>
          <a href="https://nimdvir.github.io/cce-2026/">
            AI Agents in VS Code for Academic Work ↗
          </a>
        </h3>
        <p>
          My CCE session covers using AI agents to work with files, build
          websites, and review changes.
        </p>
      </article>
    </div>
  </section>
</Layout>
