---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProfileIcon from "../components/ProfileIcon.astro";
import { cvUrl, socialLinks } from "../data/profile";
const selected = (await getCollection("projects"))
  .filter((p) =>
    ["costco-mobile-app", "dexcom-g7-plus", "barrier-free-living"].includes(
      p.slug,
    ),
  )
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
---

<Layout
  title="Nim Dvir, PhD"
  description="Nim Dvir is a UX and AI researcher, educator, and builder at the University at Albany. Explore research, industry projects, teaching, and speaking."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div>
      <p class="eyebrow">Researcher · Educator · Builder</p>
      <h1 id="home-title">
        Technology works
        <br />
        better with
        <br />
        <span class="gradient-text">people first.</span>
      </h1>
      <p class="typing-line">
        <span aria-hidden="true" data-typewriter>
          From questions to useful things.
        </span>
        <span class="sr-only">From questions to useful things.</span>
      </p>
      <p class="intro">
        I’m <strong>Nimrod (Nim) Dvir, PhD.</strong> I study how people engage
        with information and AI, turn research into better digital experiences,
        and teach others to do the same.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/projects/">
          Explore my work <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href={cvUrl}>
          View my CV <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="small">
        Lecturer, Information Systems and Business Analytics
        <br />
        Massry School of Business · University at Albany, SUNY
      </p>
    </div>
    <figure class="portrait-wrap">
      <img
        class="hero-portrait"
        src="/images/nim-dvir-cce.jpg"
        alt="Nim Dvir"
        width="800"
        height="800"
        fetchpriority="high"
      />
      <figcaption class="portrait-caption">
        <span>
          <strong>Curiosity, put to work.</strong>UX · AI · Information systems
        </span>
        <span aria-hidden="true">↗</span>
      </figcaption>
    </figure>
  </section>
  <div class="affiliation">
    <span>
      At the intersection of{" "}
      <strong>human behavior, business, and technology.</strong>
    </span>
    <a href="https://www.albany.edu/business/faculty/nim-dvir">
      Meet me at UAlbany ↗
    </a>
  </div>
  <section class="evidence-row" aria-label="Experience and recognition">
    <div class="evidence">
      <strong>10+ years</strong>
      <span>of UX and AI research</span>
    </div>
    <div class="evidence">
      <strong>Research + practice</strong>
      <span>Mixed methods, NLP, and applied analytics</span>
    </div>
    <div class="evidence">
      <strong>Award-winning</strong>
      <span>Dissertation and research · UAlbany, 2023</span>
    </div>
  </section>
  <section class="section" style="border-top:0">
    <div class="section-head">
      <div>
        <p class="eyebrow">What I do</p>
        <h2>
          Good questions.
          <br />
          <span class="marker">Useful answers.</span>
        </h2>
      </div>
      <a href="/about/">A little more about me ↗</a>
    </div>
    <div class="grid-3">
      <article class="plain-card">
        <span class="index">01 / RESEARCH</span>
        <h3>Understand people.</h3>
        <p>
          I use experiments, interviews, and computational linguistics to
          understand how language and design shape attention, trust, and
          decisions.
        </p>
        <a class="text-link" href="/research/">
          Explore the research ↗
        </a>
      </article>
      <article class="plain-card">
        <span class="index">02 / PRACTICE</span>
        <h3>Make it work better.</h3>
        <p>
          I connect user research with product and content strategy, from retail
          and health technology to museums and nonprofit services.
        </p>
        <a class="text-link" href="/projects/">
          Browse the projects ↗
        </a>
      </article>
      <article class="plain-card">
        <span class="index">03 / EDUCATION</span>
        <h3>Help others build.</h3>
        <p>
          I teach databases, analytics, Python, information systems, and
          responsible AI use through applied projects and interactive
          courseware.
        </p>
        <a class="text-link" href="/teaching/">
          Inside the classroom ↗
        </a>
      </article>
    </div>
  </section>
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Research meets the real world.</h2>
      </div>
      <a href="/projects/">All 12 portfolio projects ↗</a>
    </div>
    <div class="grid-3">
      {selected.map((p) => (
        <article class="card">
          <a
            class="card-visual contain"
            href={`/projects/${p.slug}/`}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={p.data.image}
              alt=""
              loading="lazy"
              width="640"
              height="400"
            />
          </a>
          <div class="card-body">
            <p class="eyebrow">{p.data.category}</p>
            <h3>
              <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
            </h3>
            <p>{p.data.summary}</p>
            <a class="text-link" href={`/projects/${p.slug}/`}>
              View project ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="feature-panel">
      <div>
        <p class="eyebrow">Research in focus</p>
        <h2>
          Small words.
          <br />
          Meaningful differences.
        </h2>
        <p>
          My award-winning dissertation, <em>Sticky Words</em>, investigates how
          phrasing shapes information engagement. That question now connects my
          work in AI, digital experiences, and legal language.
        </p>
        <a class="text-link" href="/research/sticky-words/">
          Discover Sticky Words ↗
        </a>
      </div>
      <a class="feature-art" href="/research/sticky-words/">
        <img
          src="/images/research/sticky-words-hero.webp"
          alt="Sticky Words research artwork"
          loading="lazy"
          width="600"
          height="375"
        />
      </a>
    </div>
  </section>
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Currently building & exploring</p>
        <h2>From prompting to workflows.</h2>
      </div>
    </div>
    <div class="grid-2">
      <article class="plain-card">
        <p class="eyebrow">Teaching + technology</p>
        <h3>Using Data to Drive Business Performance</h3>
        <p>
          An interactive textbook and courseware connecting databases, SQL,
          analytics, and business judgment. Built for learning by doing.
        </p>
        <a
          class="text-link"
          href="https://database-textbook.dimapublishing.com/"
        >
          Explore the courseware ↗
        </a>
      </article>
      <article class="plain-card">
        <p class="eyebrow">CCE 2026 · October 21–23</p>
        <h3>AI Agents in VS Code for Academic Work</h3>
        <p>
          A practical session on using AI agents for academic workflows: files,
          prompts, tools, and reviewable results.
        </p>
        <a class="text-link" href="https://nimdvir.github.io/cce-2026/">
          Visit the session website ↗
        </a>
      </article>
    </div>
  </section>
  <section class="contact-section" id="contact">
    <div>
      <p class="eyebrow">Let’s connect</p>
      <h2>
        Have a question
        <br />
        worth exploring?
      </h2>
      <p class="lede">
        Let’s talk about research collaborations, UX and AI consulting,
        teaching, or speaking.
      </p>
    </div>
    <div class="contact-details">
      <a class="contact-email" href="/contact/">
        ndvir@albany.edu ↗
      </a>
      <p class="small" style="margin-top:18px">
        Massry School of Business · BB397
        <br />
        University at Albany
        <br />
        <a href="tel:+15184421440">518-442-1440</a>
      </p>
      <nav class="social-links" aria-label="Connect with Nim">
        {socialLinks
          .filter((l) =>
            [
              "LinkedIn",
              "Google Scholar",
              "GitHub",
              "Instagram",
              "UAlbany faculty",
            ].includes(l.label),
          )
          .map((l) => (
            <a class="button" href={l.href}>
              <ProfileIcon icon={l.icon} />
              {l.label}
            </a>
          ))}
      </nav>
    </div>
  </section>
</Layout>
