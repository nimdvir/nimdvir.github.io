---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const campusImages = [
	{ src: withBase('/images/about/ualbany-campus-west.webp'), alt: 'University at Albany campus view at sunset' },
	{ src: withBase('/images/about/ualbany-campus-east.webp'), alt: 'University at Albany campus view with a broad skyline' },
];
const exploreWords = ['Self', 'Research', 'Projects', 'Media', 'Teaching'];
---

<Layout
	title="Nim Dvir, PhD"
	description="UX and AI researcher; Visiting Assistant Professor at SUNY Albany. Research in HCI, information engagement, and responsible AI."
>
	<!-- Hero Banner with Particles -->
	<div class="hero-banner">
		<div id="particles-js"></div>
		<div class="hero-content">
			<div class="hero-text">
				<span class="badge">UX + AI Researcher</span>
				<h1>Nim Dvir, PhD</h1>
				<p class="subtitle">Visiting Assistant Professor<br/>The State University of New York at Albany</p>
				<p class="intro">
					Human-computer interaction researcher focused on information engagement, 
					responsible AI, and data-driven design.
				</p>
				<div class="cta-buttons">
					<a href="mailto:ndvir@albany.edu" class="btn btn-primary">
						<i class="fas fa-envelope"></i> Contact Me
					</a>
					<a href={withBase('/about')} class="btn btn-secondary">
						<i class="fas fa-user"></i> About Me
					</a>
				</div>
			</div>
			<div class="hero-image">
				<img src={withBase('/images/headshot2025.jpg')} alt="Portrait of Nim Dvir" />
			</div>
		</div>
	</div>

	<!-- Social Links Bar -->
	<section class="social-bar">
		<a href="https://www.linkedin.com/in/nimdvir/" target="_blank" rel="noreferrer"><i class="fab fa-linkedin"></i> LinkedIn</a>
		<a href="https://scholar.google.com/citations?user=vzFELz4AAAAJ&hl=en" target="_blank" rel="noreferrer"><i class="fas fa-graduation-cap"></i> Scholar</a>
		<a href="https://orcid.org/0000-0001-5462-3180" target="_blank" rel="noreferrer"><i class="fab fa-orcid"></i> ORCID</a>
		<a href="https://www.researchgate.net/profile/Nim-Dvir" target="_blank" rel="noreferrer"><i class="fab fa-researchgate"></i> ResearchGate</a>
		<a href="https://www.instagram.com/nimdvir/" target="_blank" rel="noreferrer"><i class="fab fa-instagram"></i> Instagram</a>
	</section>

	<!-- Extended Bio Section -->
	<section class="content-section intro-container">
		<div class="hello-wrapper">
			<span class="typewriter">Hello!</span>
		</div>
		
		<div class="bio-text">
			<p class="lead">I’m Nimrod (Nim) Dvir, Ph.D.</p>
			<p>
				I am a Mixed Methods Researcher and Lecturer at the University at Albany’s Massry School of Business, specializing in Human-Computer Interaction (HCI) and Business Analytics. My work sits at the intersection of data science and behavioral psychology, where I use computational linguistics and AI-driven modeling to understand and optimize how people engage with digital information.
			</p>

			<h3>At a Glance</h3>
			<div class="stats-grid">
				<div class="stat-card">
					<span class="stat-emoji">🎓</span>
					<span class="stat-number">4</span>
					<span class="stat-label">Degrees</span>
					<span class="stat-sub">Because one was never enough</span>
				</div>
				<div class="stat-card">
					<span class="stat-emoji">📚</span>
					<span class="stat-number">15+</span>
					<span class="stat-label">Courses Taught</span>
				</div>
				<div class="stat-card">
					<span class="stat-emoji">🏆</span>
					<span class="stat-number">11</span>
					<span class="stat-label">Awards</span>
					<span class="stat-sub">Yes, I counted</span>
				</div>
				<div class="stat-card">
					<span class="stat-emoji">📺</span>
					<span class="stat-number">20+</span>
					<span class="stat-label">Media Appearances</span>
				</div>
				<div class="stat-card">
					<span class="stat-emoji">🎤</span>
					<span class="stat-number">50+</span>
					<span class="stat-label">Celebrity Interviews</span>
				</div>
			</div>

			<h3>What I Bring to the Table:</h3>
			<ul class="value-props">
				<li>
					<strong>Applied AI Research:</strong> Extensive expertise in Large Language Models (LLMs), NLP, and fine-tuning to solve complex organizational problems.
				</li>
				<li>
					<strong>Evidence-Based Design:</strong> A proven track record of collaborating with industry leaders like Costco, Dexcom, and Google to build user-centered, high-impact digital products.
				</li>
				<li>
					<strong>Education & Mentorship:</strong> Deeply committed to pedagogy, I develop and teach graduate and undergraduate courses on Python, Digital Product Design, and Managing IT.
				</li>
			</ul>

			<p>
				Whether I’m analyzing "Sticky Words" in a dissertation that earned Distinguished Research honors or mentoring the next generation of tech leaders, my goal is always to enhance business performance through innovative, ethical technology management.
			</p>

			<div class="cta-wrapper">
				<a href="mailto:ndvir@albany.edu" class="connect-btn">
					Let's connect to discuss the future of AI, UX, and Digital Citizenship.
				</a>
			</div>
		</div>
	</section>

	<section class="content-section ualbany-section">
		<div class="ualbany-section__copy">
			<div class="ualbany-heading-row">
				<h2>UAlbany — Academic Home Base</h2>
				<a
					href="https://www.albany.edu/business/faculty/nim-dvir"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Visit Nim Dvir's University at Albany faculty page"
					class="ualbany-logo-link"
				>
					<img
						src={withBase('/images/about/ualbany-logo.webp')}
						alt="University at Albany logo"
						class="ualbany-logo"
						loading="lazy"
					/>
				</a>
			</div>

			<p>
				A significant part of my current research, teaching, and collaborative work grows out of my role at
				the University at Albany. I am a faculty member in the
				<a href="https://www.albany.edu/business" target="_blank" rel="noopener noreferrer">
					Department of Information Systems and Business Analytics at the Massry School of Business
				</a>,
				where my work connects business education, data, technology, and applied research.
			</p>

			<p>
				I am also affiliated faculty in the
				<a href="https://www.albany.edu/cehc/information-sciences-and-technology" target="_blank" rel="noopener noreferrer">
					Department of Information Sciences and Technology / Informatics
				</a>
				at the College of Emergency Preparedness, Homeland Security and Cybersecurity. Together, these academic
				homes reflect the interdisciplinary nature of my work across information systems, analytics,
				artificial intelligence, human-computer interaction, and technology-driven decision-making.
			</p>
		</div>

		<div class="ualbany-section__visual" aria-label="University at Albany campus views">
			{campusImages.map((image) => (
				<figure class="campus-preview-card">
					<img src={image.src} alt={image.alt} loading="lazy" />
				</figure>
			))}
		</div>
	</section>

	<!-- Main Content Cards -->
	<section class="content-section">
		<h2 class="section-title section-title--animated">
			<i class="fas fa-compass"></i>
			<span>Learn more about my</span>
			<span class="rotating-word" id="rotating-word" data-words={JSON.stringify(exploreWords)} aria-live="polite">
				{exploreWords[0]}
			</span>
		</h2>
		<div class="nav-circles-grid">
			<a href={withBase('/about')} class="nav-circle-item">
				<div class="nav-circle">
					<i class="fas fa-user"></i>
				</div>
				<span>Self</span>
			</a>
			<a href={withBase('/research')} class="nav-circle-item">
				<div class="nav-circle">
					<i class="fas fa-microscope"></i>
				</div>
				<span>Research</span>
			</a>
			<a href={withBase('/projects')} class="nav-circle-item">
				<div class="nav-circle">
					<i class="fas fa-briefcase"></i>
				</div>
				<span>Projects</span>
			</a>
			<a href={withBase('/media')} class="nav-circle-item">
				<div class="nav-circle">
					<i class="fas fa-newspaper"></i>
				</div>
				<span>Media</span>
			</a>
			<a href={withBase('/teaching')} class="nav-circle-item">
				<div class="nav-circle">
					<i class="fas fa-chalkboard-teacher"></i>
				</div>
				<span>Teaching</span>
			</a>
		</div>
	</section>

	<script src={withBase('/js/particles.js')} is:inline></script>
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		if (typeof particlesJS !== 'undefined') {
			particlesJS('particles-js', {
				particles: {
					number: { value: 80, density: { enable: true, value_area: 900 } },
					color: { value: '#ffffff' },
					shape: { type: 'circle' },
					opacity: { value: 0.6, random: true },
					size: { value: 3, random: true },
					line_linked: { enable: true, distance: 150, color: '#ffffff', opacity: 0.4, width: 1 },
					move: { enable: true, speed: 1.5, direction: 'none', random: true, straight: false, out_mode: 'out' }
				},
				interactivity: {
					detect_on: 'canvas',
					events: {
						onhover: { enable: true, mode: 'grab' },
						onclick: { enable: true, mode: 'push' },
						resize: true
					},
					modes: {
						grab: { distance: 140, line_linked: { opacity: 1 } },
						push: { particles_nb: 4 }
					}
				},
				retina_detect: true
			});
		}

		const rotatingWord = document.getElementById('rotating-word');
		if (rotatingWord) {
			const words = JSON.parse(rotatingWord.getAttribute('data-words') || '[]');
			let currentIndex = 0;

			if (Array.isArray(words) && words.length > 1) {
				setInterval(() => {
					rotatingWord.classList.add('is-changing');
					window.setTimeout(() => {
						currentIndex = (currentIndex + 1) % words.length;
						rotatingWord.textContent = words[currentIndex];
						rotatingWord.classList.remove('is-changing');
					}, 180);
				}, 2200);
			}
		}
	});
</script>
</Layout>

<style>
	:global(:root) {
		--home-navy-950: #081a33;
		--home-navy-900: #0e2d57;
		--home-navy-800: #18467f;
		--home-gold-500: #d6a328;
		--home-gold-400: #e7bc54;
		--home-gold-300: #f5ddb0;
		--home-gold-100: #fff8e7;
	}

	/* Hero Banner */
	.hero-banner {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -24px;
		background:
			radial-gradient(circle at top right, rgba(231, 188, 84, 0.16), transparent 24%),
			linear-gradient(135deg, #1e3a5f 0%, #0f172a 46%, #16365f 100%);
		padding: 60px 24px;
		margin-bottom: 0;
	}

	#particles-js {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 48px;
		align-items: center;
	}

	.hero-text {
		color: #fff;
	}

	.badge {
		display: inline-block;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(231, 188, 84, 0.42);
		padding: 6px 16px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 16px;
		color: #fff6d9;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.hero-text h1 {
		font-size: 56px;
		margin: 0 0 12px;
		letter-spacing: -0.03em;
		font-weight: 700;
		line-height: 1.1;
	}

	.hero-text .subtitle {
		font-size: 20px;
		margin: 0 0 20px;
		opacity: 0.9;
		line-height: 1.4;
	}

	.hero-text .intro {
		font-size: 17px;
		margin: 0 0 28px;
		opacity: 0.85;
		line-height: 1.6;
		max-width: 500px;
	}

	.cta-buttons {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 24px;
		border-radius: 12px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
		font-size: 15px;
	}

	.btn-primary {
		background: #fff;
		color: #0f172a;
	}

	.btn-primary:hover {
		background: #f8fafc;
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.32);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.45);
		transform: translateY(-2px);
	}

	.hero-image {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-image img {
		width: 300px;
		height: 300px;
		object-fit: cover;
		object-position: 65% 20%;
		border-radius: 50%;
		border: 4px solid rgba(255, 255, 255, 0.22);
		box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
	}

	/* Social Bar */
	.social-bar {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
		padding: 24px;
		background: #fff;
		border-bottom: 1px solid #e5e7eb;
		margin-bottom: 40px;
	}

	.social-bar a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 16px;
		border-radius: 10px;
		background: #f8fafc;
		color: #374151;
		text-decoration: none;
		font-weight: 600;
		font-size: 14px;
		border: 1px solid #e5e7eb;
		transition: all 0.2s ease;
	}

	.social-bar a:hover {
		background: #0f172a;
		color: #fff;
		border-color: #0f172a;
		transform: translateY(-2px);
	}

	/* Content Sections */
	.content-section {
		max-width: 1100px;
		margin: 0 auto 48px;
		padding: 0 24px;
	}

	.section-title {
		font-size: 24px;
		margin: 0 0 24px;
		color: #0f172a;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.section-title i {
		color: var(--home-gold-500);
	}

	.section-title--animated {
		flex-wrap: wrap;
	}

	.rotating-word {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 9ch;
		padding: 6px 14px;
		border-radius: 999px;
		background: linear-gradient(135deg, rgba(231, 188, 84, 0.2), rgba(214, 163, 40, 0.45));
		color: var(--home-navy-950);
		box-shadow: 0 8px 20px rgba(214, 163, 40, 0.18);
		border: 1px solid rgba(214, 163, 40, 0.4);
		transition: opacity 0.18s ease, transform 0.18s ease;
	}

	.rotating-word.is-changing {
		opacity: 0;
		transform: translateY(8px);
	}

	.ualbany-section {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
		gap: 28px;
		align-items: center;
		padding: 32px 24px;
		border: 1px solid #dbe4ef;
		border-radius: 20px;
		background: linear-gradient(135deg, #f8fafc 0%, #edf4ff 100%);
		box-shadow: 0 14px 32px rgba(15, 23, 42, 0.06);
	}

	.ualbany-section__copy {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.ualbany-heading-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.ualbany-heading-row h2 {
		margin: 0;
		font-size: 30px;
		letter-spacing: -0.02em;
		color: #0f172a;
	}

	.ualbany-logo-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px 14px;
		border-radius: 16px;
		background: #ffffff;
		border: 1px solid #dbe4ef;
		box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
	}

	.ualbany-logo {
		height: 44px;
		width: auto;
		display: block;
	}

	.ualbany-section p {
		margin: 0;
		color: #334155;
		line-height: 1.75;
		font-size: 16px;
	}

	.ualbany-section a {
		color: #1d4ed8;
		font-weight: 600;
		text-decoration-color: rgba(214, 163, 40, 0.65);
		text-underline-offset: 0.18em;
	}

	.ualbany-section__visual {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.campus-preview-card {
		margin: 0;
	}

	.campus-preview-card img {
		display: block;
		width: 100%;
		height: 210px;
		object-fit: cover;
		border-radius: 18px;
		border: 1px solid #cbd5e1;
		box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
	}

	/* Nav Circles Grid */
	.nav-circles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 32px;
		max-width: 960px;
		margin: 0 auto;
	}

	.nav-circle-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: #0f172a;
		transition: transform 0.2s ease;
	}

	.nav-circle-item:hover {
		transform: translateY(-4px);
	}

	.nav-circle {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		background: linear-gradient(135deg, #1e3a5f, #0f172a);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 36px;
		color: #fff;
		box-shadow: 0 8px 24px rgba(30, 58, 95, 0.25);
		transition: box-shadow 0.2s ease;
	}

	.nav-circle-item:hover .nav-circle {
		box-shadow: 0 12px 32px rgba(30, 58, 95, 0.4), 0 0 0 6px rgba(214, 163, 40, 0.1);
	}

	.nav-circle-item span {
		font-weight: 600;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.hero-content {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.ualbany-section {
			grid-template-columns: 1fr;
		}

		.hero-text h1 {
			font-size: 40px;
		}

		.hero-text .intro {
			max-width: 100%;
		}

		.cta-buttons {
			justify-content: center;
		}

		.hero-image {
			max-width: 280px;
			margin: 0 auto;
		}
	}

	@media (max-width: 600px) {
		.hero-banner {
			padding: 40px 16px;
		}

		.hero-text h1 {
			font-size: 32px;
		}

		.hero-text .subtitle {
			font-size: 16px;
		}

		/* Nav Circles Responsive */
		.nav-circles-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 24px;
		}

		.ualbany-section {
			padding: 24px 18px;
		}

		.ualbany-heading-row h2 {
			font-size: 24px;
		}

		.ualbany-section__visual {
			grid-template-columns: 1fr;
		}

		.nav-circle {
			width: 80px;
			height: 80px;
			font-size: 28px;
		}

		.social-bar {
			gap: 8px;
		}

		.social-bar a {
			padding: 8px 12px;
			font-size: 13px;
		}
	}

	/* Intro Section & Typewriter */
	.intro-container {
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		padding: 40px !important;
		margin-bottom: 48px;
	}

	.hello-wrapper {
		margin-bottom: 24px;
	}

	.typewriter {
		font-family: 'Courier New', Courier, monospace;
		font-size: 32px;
		font-weight: 700;
		color: var(--home-navy-900);
		display: inline-block;
		overflow: hidden;
		border-right: 3px solid var(--home-gold-500);
		white-space: nowrap;
		letter-spacing: 0.05em;
		animation: 
			typing 2.5s steps(10, end) infinite,
			blink-caret 0.75s step-end infinite;
		max-width: fit-content;
	}

	@keyframes typing {
		0% { width: 0 }
		15% { width: 0 }
		40% { width: 6ch } /* "Hello!" is 6 chars */
		75% { width: 6ch }
		90% { width: 0 }
		100% { width: 0 }
	}

	@keyframes blink-caret {
		from, to { border-color: transparent }
		50% { border-color: var(--home-gold-500); }
	}

	.bio-text {
		font-size: 17px;
		line-height: 1.7;
		color: #374151;
	}

	.lead {
		font-size: 20px;
		font-weight: 600;
		color: #0f172a;
		margin-bottom: 16px;
	}

	.bio-text h3 {
		font-size: 20px;
		margin: 32px 0 16px;
		color: #0f172a;
	}

	.value-props {
		margin: 0 0 24px;
		padding-left: 20px;
	}

	.value-props li {
		margin-bottom: 12px;
	}

	.stats-grid {
		display: grid;
