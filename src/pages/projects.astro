---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

const projectEntries = await getCollection('projects');
const projects = projectEntries.sort((left, right) => {
	const orderDelta = (left.data.sortOrder ?? 999) - (right.data.sortOrder ?? 999);
	return orderDelta !== 0 ? orderDelta : left.data.title.localeCompare(right.data.title);
});

const categories = [...new Set(projects.map((project) => project.data.category))];
const featuredCount = projects.filter((project) => project.data.featured).length;
---

<Layout
	title="Projects"
	description="Selected industry collaborations and case studies spanning accessibility, culture, commerce, and health tech."
>
	<section class="hero">
		<div class="hero__text">
			<p class="eyebrow"><i class="fas fa-briefcase"></i> Projects · Case Studies</p>
			<h1>Industry collaborations and case studies across sectors.</h1>
			<p class="lede">
				A curated set of client-facing case studies spanning retail, health tech, culture, publishing,
				nonprofit work, and brand strategy. Each entry documents an industry collaboration or applied design
				engagement rather than a loose project teaser.
			</p>
			<div class="hero__stats">
				<p><strong>{projects.length}</strong> case studies</p>
				<p><strong>{featuredCount}</strong> featured projects</p>
				<p><strong>{projects.filter((project) => project.data.client).length}</strong> industry collaborations</p>
			</div>
		</div>
		<div class="hero__image">
			<img src={withBase('/images/portfolio.jpg')} alt="Portfolio overview" loading="lazy" />
		</div>
	</section>

	<section class="overview" aria-label="Project categories">
		<div>
			<h2>Case-study focus</h2>
			<p>
				This section is intentionally framed as case studies and industry collaborations. It separates applied
				practice from research so the portfolio can show client context, role, and outcomes more clearly.
			</p>
		</div>
		<ul class="category-list">
			{categories.map((category) => (
				<li>{category}</li>
			))}
		</ul>
	</section>

	<section class="grid">
		{projects.map((project) => (
			<article class="card">
				<a href={withBase(`/projects/${project.slug}/`)} class="card__image-link">
					{project.data.image && (
						<img src={withBase(project.data.image)} alt={project.data.title} loading="lazy" />
					)}
				</a>
				<div class="body">
					<div class="card-badges">
						<span class="case-study-pill">Case Study</span>
						<span class="category"><i class="fas fa-tag"></i> {project.data.client ? 'Industry collaboration' : 'Applied work'} · {project.data.category}</span>
					</div>
					<h2>
						<a href={withBase(`/projects/${project.slug}/`)}>{project.data.title}</a>
					</h2>
					<p>{project.data.summary}</p>
					{(project.data.client || project.data.role) && (
						<p class="description">
							{project.data.client && <span><strong>Client:</strong> {project.data.client}</span>}
							{project.data.role && <span><strong>Role:</strong> {project.data.role}</span>}
						</p>
					)}
					<a class="case-study-link" href={withBase(`/projects/${project.slug}/`)}>
						View case study <i class="fas fa-arrow-right" aria-hidden="true"></i>
					</a>
				</div>
			</article>
		))}
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
		align-items: center;
		padding: 12px 0 20px;
	}

	.hero__text {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.hero__stats {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero__stats p {
		margin: 0;
		padding: 10px 14px;
		border-radius: 999px;
		background: #eff6ff;
		color: #1e3a5f;
		font-size: 14px;
	}

	.hero__image img {
		width: 100%;
		height: auto;
		border-radius: 18px;
		border: 1px solid #e5e7eb;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: #6b7280;
		margin: 0;
	}

	h1 {
		margin: 0;
		font-size: 32px;
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0;
		color: #1f2937;
		line-height: 1.6;
		font-size: 17px;
		max-width: 680px;
	}

	.overview {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		align-items: start;
		padding: 8px 0 12px;
	}

	.overview h2 {
		margin: 0 0 8px;
		font-size: 22px;
	}

	.overview p {
		color: #334155;
		line-height: 1.6;
	}

	.category-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.category-list li {
		padding: 10px 14px;
		border-radius: 999px;
		background: #f8fafc;
		border: 1px solid #dbe4ef;
		color: #1e293b;
		font-weight: 600;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 18px;
		margin-top: 24px;
	}

	.card {
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.04);
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
	}

	.card__image-link {
		display: block;
	}

	.card img {
		width: 100%;
		height: 200px;
		object-fit: cover;
	}

	.body {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.body a {
		text-decoration: none;
	}

	.category {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #6b7280;
	}

	.card-badges {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.case-study-pill {
		width: fit-content;
		padding: 6px 10px;
		border-radius: 999px;
		background: #dbeafe;
		color: #1d4ed8;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.category i {
		color: #3b82f6;
	}

	h2 {
		margin: 0;
		font-size: 20px;
		letter-spacing: -0.01em;
	}

	h2 a:hover {
		color: #1d4ed8;
	}

	h2 i {
		color: #6b7280;
	}

	p {
		margin: 0;
		color: #111827;
		line-height: 1.5;
	}

	.description {
		font-size: 14px;
		color: #475569;
		padding: 12px;
		background: #f8fafc;
		border-radius: 8px;
		border: 1px solid #e2e8f0;
		display: grid;
		gap: 6px;
	}

	.case-study-link {
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #1d4ed8;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 26px;
		}

		.lede {
			font-size: 16px;
		}

		.hero__image img {
			border-radius: 14px;
		}
	}
</style>
