---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99),
);
const categories = [...new Set(projects.map((p) => p.data.category))];
---

<Layout
  title="Projects | UX Research and Design"
  description="Professional work and student projects advised by Nim Dvir, with research reports, designs, and prototypes."
>
  <header class="page-intro">
    <h1>Projects</h1>
    <p class="lede">
      These projects include my professional work and student projects I
      advised. Each page identifies my role and includes the available reports,
      designs, or prototypes.
    </p>
  </header>
  <div
    class="project-filters"
    role="group"
    aria-label="Filter projects by category"
    hidden
  >
    <button class="filter-button" data-filter="all" aria-pressed="true">
      All projects
    </button>
    {categories.map((c) => (
      <button class="filter-button" data-filter={c} aria-pressed="false">
        {c}
      </button>
    ))}
  </div>
  <p id="filter-status" class="small" role="status" aria-live="polite">
    {projects.length} projects shown
  </p>
  <section class="project-grid" aria-label="Portfolio projects">
    {projects.map((p, i) => (
      <article class="card" data-project-category={p.data.category}>
        <a
          class="card-visual contain"
          href={`/projects/${p.slug}/`}
          tabindex="-1"
          aria-hidden="true"
        >
          {p.data.image ? (
            <img
              src={p.data.image}
              alt=""
              width="640"
              height="400"
              loading="lazy"
            />
          ) : (
            <span class="project-monogram">
              {String(i + 1).padStart(2, "0")} /{" "}
              {p.data.title.slice(0, 2).toUpperCase()}
            </span>
          )}
        </a>
        <div class="card-body">
          <p class="eyebrow">{p.data.category}</p>
          <h2>
            <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
          </h2>
          <p>{p.data.summary}</p>
          {p.data.role && <p class="small">{p.data.role}</p>}
          <a class="text-link" href={`/projects/${p.slug}/`}>
            View project
          </a>
        </div>
      </article>
    ))}
  </section>
</Layout>
