---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99),
);
const categories = [...new Set(projects.map((p) => p.data.category))];
---

<Layout
  title="Projects"
  description="Explore Nim Dvir’s complete portfolio of 12 UX research, product design, content strategy, and industry projects."
>
  <header class="page-intro">
    <p class="eyebrow">Projects / Applied work</p>
    <h1>
      Better experiences
      <br />
      begin with <span class="marker">people.</span>
    </h1>
    <p class="lede">
      Twelve projects across commerce, health, culture, and digital services.
      Research and professional work sit alongside student projects I advised,
      with the context identified in each case study.
    </p>
  </header>
  <div
    class="project-filters"
    role="group"
    aria-label="Filter projects by category"
    hidden
  >
    <button class="filter-button" data-filter="all" aria-pressed="true">
      All projects
    </button>
    {categories.map((c) => (
      <button class="filter-button" data-filter={c} aria-pressed="false">
        {c}
      </button>
    ))}
  </div>
  <p id="filter-status" class="small" role="status" aria-live="polite">
    {projects.length} projects shown
  </p>
  <section class="project-grid" aria-label="Portfolio projects">
    {projects.map((p, i) => (
      <article class="card" data-project-category={p.data.category}>
        <a
          class="card-visual contain"
          href={`/projects/${p.slug}/`}
          tabindex="-1"
          aria-hidden="true"
        >
          {p.data.image ? (
            <img
              src={p.data.image}
              alt=""
              width="640"
              height="400"
              loading="lazy"
            />
          ) : (
            <span class="project-monogram">
              {String(i + 1).padStart(2, "0")} /{" "}
              {p.data.title.slice(0, 2).toUpperCase()}
            </span>
          )}
        </a>
        <div class="card-body">
          <p class="eyebrow">{p.data.category}</p>
          <h2>
            <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
          </h2>
          <p>{p.data.summary}</p>
          {p.data.role && <p class="small">{p.data.role}</p>}
          <a class="text-link" href={`/projects/${p.slug}/`}>
            Explore project ↗
          </a>
        </div>
      </article>
    ))}
  </section>
  <aside class="highlight-panel">
    <h2>Have a project in mind?</h2>
    <p>
      I welcome collaborations that connect user research, AI, and practical
      design decisions.
    </p>
    <a class="text-link" href="mailto:ndvir@albany.edu">
      Let’s talk ↗
    </a>
  </aside>
</Layout>
