---
import Layout from "../layouts/Layout.astro";
import { Content } from "../data/cv-public.md";
---

<Layout
  title="Curriculum Vitae"
  description="Nim Dvir’s curriculum vitae: academic appointments, education, research, publications, teaching, and service. Updated September 2026."
>
  <header class="page-intro">
    <h1>Curriculum vitae</h1>
    <p class="lede">
      Nimrod (Nim) Dvir, PhD, MBA
      <br />
      Lecturer · Massry School of Business · University at Albany, SUNY
    </p>
    <p class="small">
      Academic record updated September 16, 2026. Public copy edited October 2,
      2026.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/files/Nim-Dvir-CV-2026-09.pdf">
        Download CV (PDF)
      </a>
      <a class="button" href="/about/">
        About me
      </a>
    </div>
  </header>
  <article class="prose cv-content">
    <Content />
  </article>
</Layout>
<style>
  .cv-content {
    margin-inline: auto;
  }
  .cv-content :global(h2) {
    font-size: 2rem;
    border-top: 1px solid var(--border);
    padding-top: 32px;
    margin-top: 40px;
  }
  .cv-content :global(h3) {
    font-size: 1.5rem;
  }
  .cv-content :global(h4) {
    font-size: 1.2rem;
  }
</style>
