---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import InterviewWall from "../../components/InterviewWall.astro";
import {
  getArticles,
  articleGroup,
  articleGroupOrder,
  articleGroupLabel,
} from "../../utils/articles";
import { canonicalTags } from "../../utils/tags";

const articles = await getArticles();
const byGroup = new Map(articleGroupOrder.map((g) => [g, [] as typeof articles]));
for (const a of articles) byGroup.get(articleGroup(a))!.push(a);

// The six interviews from the live site lead the wall, then the other
// interviews with a photo, then the rest (each newest first).
const featured = [
  "lady-gaga",
  "jamie-foxx",
  "julia-louis-dreyfus",
  "jim-carrey",
  "rupaul",
  "michael-fassbender",
];
const wallRank = (a: (typeof articles)[number]) => {
  const f = featured.indexOf(a.slug);
  return f >= 0 ? f : a.data.image ? featured.length : featured.length + 1;
};
const international = byGroup
  .get("international-interview")!
  .map((a, i) => ({ a, i }))
  .sort((x, y) => wallRank(x.a) - wallRank(y.a) || x.i - y.i)
  .map(({ a }) => a);
const israeli = byGroup.get("israeli-interview")!;
const own = articles.filter((a) => !a.data.thirdPartyCoverage);
const interviews = international.length + israeli.length;
const sources = [...new Set(own.map((a) => a.data.source))];
const years = own.map((a) => Number(a.data.date.slice(0, 4)));
const first = Math.min(...years);
const last = Math.max(...years);

// Most-used topics across the archive, for the "Browse by topic" row.
const topicCounts = new Map<string, { slug: string; label: string; count: number }>();
for (const a of articles)
  for (const t of canonicalTags(a.data.tags)) {
    const cur = topicCounts.get(t.slug) ?? { slug: t.slug, label: t.label, count: 0 };
    cur.count += 1;
    topicCounts.set(t.slug, cur);
  }
const topics = [...topicCounts.values()]
  .filter((t) => t.count > 1)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
  .slice(0, 16);

const sections = [
  {
    id: "features",
    group: "feature",
    lede: "Set visits, backstage reporting and researched profiles.",
  },
  {
    id: "reviews",
    group: "review",
    lede: "Film, television and books, judged in print.",
  },
  {
    id: "columns",
    group: "column",
    lede: "First-person columns and opinion, mostly from New York.",
  },
  {
    id: "about-me",
    group: "about-me",
    lede: "Pieces by other journalists in which I am the subject. Included for the record, with their original bylines.",
  },
] as const;
---

<Layout
  title="Articles"
  description={`${own.length} interviews, features, reviews and columns that Nim Dvir published in Hebrew between ${first} and ${last}, translated into English with the original sources.`}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Articles", path: "/articles/" },
  ]}
>
  <header class="page-intro archive-intro">
    <p class="eyebrow">Journalism archive · {first} to {last}</p>
    <h1>Articles</h1>
    <p class="lede">
      Before the PhD I was an entertainment journalist, most of that time as the
      New York correspondent for Israel's largest news sites. I interviewed
      {interviews} people, from Lady Gaga and Ryan Gosling to Israel's own
      stars, visited sets, and wrote columns about living between two
      countries. Everything here is translated from the published Hebrew, with
      the original linked on every page.
    </p>
    <dl class="archive-stats" aria-label="Archive at a glance">
      <div><dt>Interviews</dt><dd>{interviews}</dd></div>
      <div><dt>Articles</dt><dd>{own.length}</dd></div>
      <div><dt>Outlets</dt><dd>{sources.length}</dd></div>
      <div><dt>Years</dt><dd>{last - first + 1}</dd></div>
    </dl>
    <nav class="archive-nav" aria-label="Sections">
      {international.length > 0 && <a href="#celebrity-interviews">Celebrity interviews</a>}
      <a href="#television">Television</a>
      {israeli.length > 0 && <a href="#israeli-interviews">Israeli interviews</a>}
      {sections.map(
        (s) =>
          byGroup.get(s.group)!.length > 0 && (
            <a href={`#${s.id}`}>{articleGroupLabel(s.group)}</a>
          ),
      )}
      <a href="/articles/voice/" class="archive-nav-voice">The voice: Hebrew to English</a>
    </nav>
    {topics.length > 0 && (
      <div class="archive-topics">
        <p class="eyebrow">Browse by topic</p>
        <ul class="tag-cloud" aria-label="Article topics">
          {topics.map((t) => (
            <li>
              <a href={`/tags/${t.slug}/`}>
                {t.label}
                <span class="tag-count">{t.count}</span>
              </a>
            </li>
          ))}
          <li><a href="/tags/">All topics →</a></li>
        </ul>
      </div>
    )}
  </header>

  {international.length > 0 && (
    <InterviewWall
      id="celebrity-interviews"
      eyebrow={`${international.length} conversations`}
      heading="Celebrity interviews"
      lede="Hotel suites, junket tables and transatlantic phone lines. Click a face to read the interview."
      articles={international}
      tone="dark"
    />
  )}

  <section class="section archive-section" id="television" aria-labelledby="television-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">2 clips</p>
        <h2 id="television-heading">Television</h2>
      </div>
    </div>
    <div class="grid-2">
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/0cPdG0gx3fM"
            title="Nim Dvir on Donald Trump, Profile, Israeli television, 2016"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>On Donald Trump, for the Israeli TV show Profile</h3>
        <p class="small">
          A guest on the Profile panel, I talked about Donald Trump's public
          behavior and where it comes from. The clip runs four and a half
          minutes, edited, with English subtitles.
        </p>
        <p class="small">
          September 26, 2016 ·{" "}
          <a href="https://youtu.be/0cPdG0gx3fM" target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>
        </p>
      </article>
      <article>
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/-ZLoYBUchmI"
            title="Nim Dvir at The Dictator press conference with Sacha Baron Cohen, 2012"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
        <h3>The Dictator press conference</h3>
        <p class="small">
          With Sacha Baron Cohen, in character, in New York.{" "}
          <a href="/articles/dictator-coverage/">How the Israeli press covered it</a>.
        </p>
        <p class="small">
          May 8, 2012 ·{" "}
          <a href="https://youtu.be/-ZLoYBUchmI" target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>
        </p>
      </article>
    </div>
  </section>

  {israeli.length > 0 && (
    <InterviewWall
      id="israeli-interviews"
      eyebrow={`${israeli.length} conversations`}
      heading="Israeli interviews"
      lede="Singers, actors, chefs and television people, in Tel Aviv and in New York."
      articles={israeli}
      tone="light"
    />
  )}

  {sections.map((s) => {
    const items = byGroup.get(s.group)!;
    return (
      items.length > 0 && (
        <section class="section archive-section" id={s.id} aria-labelledby={`${s.id}-heading`}>
          <div class="section-head">
            <div>
              <p class="eyebrow">{items.length} {items.length === 1 ? "piece" : "pieces"}</p>
              <h2 id={`${s.id}-heading`}>{articleGroupLabel(s.group)}</h2>
              <p class="small archive-section-lede">{s.lede}</p>
            </div>
          </div>
          <div class="project-grid article-grid grid-3">
            {items.map((article) => (
              <ArticleCard article={article} headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    );
  })}

  <section class="section archive-notes">
    <div class="section-head">
      <h2>About this archive</h2>
    </div>
    <div class="grid-2">
      <div>
        <h3>Translations</h3>
        <p class="small">
          Every article was translated from the verified Hebrew text, keeping
          each paragraph, question and answer in its original order and in my
          own voice. Quotes are translations of what was published in Hebrew,
          not recovered English transcripts. Publications represented: {sources.join(", ")}.
        </p>
      </div>
      <div>
        <h3>Images and sources</h3>
        <p class="small">
          Lead photos come from my own archive (one is from Wikimedia Commons)
          and are credited on each page. Where the photographs that ran with an article
          could be recovered, they appear inside it with their original captions
          and credits. Each page links to the original article and to the
          archived Hebrew text.
        </p>
      </div>
    </div>
  </section>
</Layout>
