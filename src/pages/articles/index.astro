---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import InterviewWall from "../../components/InterviewWall.astro";
import {
  getArticles,
  articleGroup,
  articleGroupOrder,
  articleGroupLabel,
} from "../../utils/articles";

const articles = await getArticles();
const byGroup = new Map(articleGroupOrder.map((g) => [g, [] as typeof articles]));
for (const a of articles) byGroup.get(articleGroup(a))!.push(a);

const international = byGroup.get("international-interview")!;
const israeli = byGroup.get("israeli-interview")!;
const own = articles.filter((a) => !a.data.thirdPartyCoverage);
const interviews = international.length + israeli.length;
const sources = [...new Set(own.map((a) => a.data.source))];
const years = own.map((a) => Number(a.data.date.slice(0, 4)));
const first = Math.min(...years);
const last = Math.max(...years);

const sections = [
  {
    id: "features",
    group: "feature",
    lede: "Set visits, backstage reporting and researched profiles.",
  },
  {
    id: "reviews",
    group: "review",
    lede: "Film, television and books, judged in print.",
  },
  {
    id: "columns",
    group: "column",
    lede: "First-person columns and opinion, mostly from New York.",
  },
  {
    id: "about-me",
    group: "about-me",
    lede: "Pieces by other journalists in which I am the subject. Included for the record, with their original bylines.",
  },
] as const;
---

<Layout
  title="Articles"
  description={`${own.length} interviews, features, reviews and columns that Nim Dvir published in Hebrew between ${first} and ${last}, translated into English with the original sources.`}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Articles", path: "/articles/" },
  ]}
>
  <header class="page-intro archive-intro">
    <p class="eyebrow">Journalism archive · {first} to {last}</p>
    <h1>Articles</h1>
    <p class="lede">
      Before the PhD I was an entertainment journalist, most of that time as the
      New York correspondent for Israel's largest news sites. I interviewed
      {interviews} people, from Lady Gaga and Ryan Gosling to Israel's own
      stars, visited sets, and wrote columns about living between two
      countries. Everything here is translated from the published Hebrew, with
      the original linked on every page.
    </p>
    <dl class="archive-stats" aria-label="Archive at a glance">
      <div><dt>Interviews</dt><dd>{interviews}</dd></div>
      <div><dt>Articles</dt><dd>{own.length}</dd></div>
      <div><dt>Outlets</dt><dd>{sources.length}</dd></div>
      <div><dt>Years</dt><dd>{last - first + 1}</dd></div>
    </dl>
    <nav class="archive-nav" aria-label="Sections">
      {international.length > 0 && <a href="#celebrity-interviews">Celebrity interviews</a>}
      {israeli.length > 0 && <a href="#israeli-interviews">Israeli interviews</a>}
      {sections.map(
        (s) =>
          byGroup.get(s.group)!.length > 0 && (
            <a href={`#${s.id}`}>{articleGroupLabel(s.group)}</a>
          ),
      )}
      <a href="/articles/voice/" class="archive-nav-voice">The voice: Hebrew to English</a>
    </nav>
  </header>

  {international.length > 0 && (
    <InterviewWall
      id="celebrity-interviews"
      eyebrow={`${international.length} conversations`}
      heading="Celebrity interviews"
      lede="Hotel suites, junket tables and transatlantic phone lines. Click a face to read the interview."
      articles={international}
      tone="dark"
    />
  )}

  {israeli.length > 0 && (
    <InterviewWall
      id="israeli-interviews"
      eyebrow={`${israeli.length} conversations`}
      heading="Israeli interviews"
      lede="Singers, actors, chefs and television people, in Tel Aviv and in New York."
      articles={israeli}
      tone="light"
    />
  )}

  {sections.map((s) => {
    const items = byGroup.get(s.group)!;
    return (
      items.length > 0 && (
        <section class="section archive-section" id={s.id} aria-labelledby={`${s.id}-heading`}>
          <div class="section-head">
            <div>
              <p class="eyebrow">{items.length} {items.length === 1 ? "piece" : "pieces"}</p>
              <h2 id={`${s.id}-heading`}>{articleGroupLabel(s.group)}</h2>
              <p class="small archive-section-lede">{s.lede}</p>
            </div>
          </div>
          <div class="project-grid article-grid grid-3">
            {items.map((article) => (
              <ArticleCard article={article} headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    );
  })}

  <section class="section archive-notes">
    <div class="section-head">
      <h2>About this archive</h2>
    </div>
    <div class="grid-2">
      <div>
        <h3>Translations</h3>
        <p class="small">
          Every article was translated from the verified Hebrew text, keeping
          each paragraph, question and answer in its original order and in my
          own voice. Quotes are translations of what was published in Hebrew,
          not recovered English transcripts. Publications represented: {sources.join(", ")}.
        </p>
      </div>
      <div>
        <h3>Images and sources</h3>
        <p class="small">
          Portraits are licensed Wikimedia Commons photographs, credited on each
          page. The publishers' original photographs are not reproduced. Each
          page links to the original article and to the archived Hebrew text.
        </p>
      </div>
    </div>
  </section>
</Layout>
