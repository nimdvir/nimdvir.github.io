---
import Layout from "../../layouts/Layout.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { getPosts, formatDate, readingMinutes } from "../../utils/editorial";
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const articleUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.summary,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  datePublished: post.data.date,
  author: {
    "@type": "Person",
    "@id": new URL("#person", Astro.site).href,
    name: "Nim Dvir",
    url: new URL("/cv/", Astro.site).href,
  },
  ...(post.data.image
    ? { image: new URL(post.data.image, Astro.site).href }
    : {}),
};
---

<Layout
  title={post.data.title}
  description={post.data.summary}
  type="article"
  structuredData={[articleSchema]}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: post.data.title, path: `/blog/${post.slug}/` },
  ]}
  image={post.data.image}
>
  <article class="editorial-article">
    <header class="editorial-article-header">
      <a class="back-link" href="/blog/">
        ← All posts
      </a>
      <p class="eyebrow">
        Blog{post.data.category && ` / ${post.data.category}`}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.summary}</p>
      <p class="post-meta">
        By Nim Dvir ·{" "}
        <time datetime={post.data.date}>{formatDate(post.data.date)}</time> ·{" "}
        {readingMinutes(post.body)} min read
      </p>
      {post.data.tags.length > 0 && (
        <ul class="editorial-tags" aria-label="Topics">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>
    {post.data.image && (
      <figure class="editorial-cover">
        <img src={post.data.image} alt={post.data.imageAlt} />
        {post.data.imageCaption && (
          <figcaption>{post.data.imageCaption}</figcaption>
        )}
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
    <RelatedPosts currentSlug={post.slug} />
  </article>
</Layout>
