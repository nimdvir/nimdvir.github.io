---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { verifiedResearch } from "../../data/profile";
export async function getStaticPaths() {
  return (await getCollection("research"))
    .filter((e) => verifiedResearch.includes(e.slug))
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image}
>
  <article class="post">
    <a class="back-link" href="/research/">
      ← All research
    </a>
    <p class="eyebrow" style="margin-top:28px">
      {entry.data.category}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    <ul class="meta">
      {[entry.data.year, entry.data.status].filter(Boolean).map((t) => (
        <li>{t}</li>
      ))}
    </ul>
    {entry.data.image && (
      <img
        class="hero-image"
        src={entry.data.image}
        alt={entry.data.imageAlt ?? entry.data.title}
        width="900"
        height="560"
      />
    )}
    <div class="content">
      <Content />
    </div>
    {entry.data.galleryImages?.length > 1 && (
      <div class="gallery">
        {entry.data.galleryImages
          .filter((i) => i !== entry.data.image)
          .map((i, n) => (
            <a href={i}>
              <img
                src={i}
                alt={`${entry.data.title} research artwork ${n + 1}`}
                loading="lazy"
              />
            </a>
          ))}
      </div>
    )}
    <ul class="tag-list">
      {entry.data.tags.map((t) => (
        <li>{t}</li>
      ))}
    </ul>
    <div class="button-row">
      <a class="button" href="/research/">
        ← More research
      </a>
      <a class="button button-primary" href="/contact/">
        Discuss this research ↗
      </a>
    </div>
  </article>
</Layout>
