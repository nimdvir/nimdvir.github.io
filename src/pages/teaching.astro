---
import Layout from "../layouts/Layout.astro";
import { cvUrl } from "../data/profile";
const graduate = [
  [
    "BITM 522",
    "Managing Information Technology",
    "University at Albany · MBA · 2022–2026",
  ],
  [
    "INF 501",
    "Case Studies in Digital Citizenship",
    "University at Albany · 2022–2026",
  ],
  [
    "BITM 534",
    "Field Study in Information Systems and Business Analytics",
    "University at Albany · course development · 2022",
  ],
  [
    "INFO 646",
    "Digital Product Design (Advanced User Experience Design)",
    "Pratt Institute · course development · 2019",
  ],
  [
    "INFO 642",
    "Content Strategy",
    "Pratt Institute · course development · 2019",
  ],
];
const undergraduate = [
  [
    "BITM 330",
    "Improving Business Performance with Information Technologies",
    "University at Albany · 2021–2026 · in person and online",
  ],
  [
    "INF 401",
    "Case Studies in Digital Citizenship",
    "University at Albany · 2021–2026 · online",
  ],
  [
    "ISBA 434",
    "Business Analytics Practicum",
    "University at Albany · 2021, 2022, 2024–2026",
  ],
  [
    "INF 495",
    "Special Topics in Research, Applied and Experiential Learning",
    "University at Albany · 2021",
  ],
  ["INF 462/562", "Current Technologies in Web Design", "SUNY Online · 2020"],
  [
    "INF 108",
    "Programming for Problem Solving: Introduction to Python",
    "University at Albany and SUNY Online · 2017–2023",
  ],
  [
    "INF 308",
    "Programming for Informatics: Advanced Python",
    "University at Albany · 2017–2021",
  ],
  [
    "INF 496",
    "UX in E-Commerce: Principles, Methods, and Technologies",
    "Academic College of Tel Aviv-Yaffo and University at Albany · 2017–2020",
  ],
  [
