---
import Layout from "../layouts/Layout.astro";
import SectionMenu from "../components/SectionMenu.astro";
import { cvUrl } from "../data/profile";
const menu = [
  { id: "courses", label: "Courses" },
  { id: "business-analytics-certificate", label: "Certificate" },
  { id: "courseware", label: "Courseware" },
  { id: "student-projects", label: "Student projects" },
  { id: "student-feedback", label: "Student feedback" },
  { id: "online-teaching", label: "Online teaching" },
  { id: "ai-in-coursework", label: "AI in coursework" },
  { id: "workshops", label: "Workshops" },
];
const graduate = [
  [
    "BITM 522",
    "Managing Information Technology",
    "University at Albany · MBA · 2022–2026",
  ],
  [
    "INF 501",
    "Case Studies in Digital Citizenship",
    "University at Albany · 2022–2026",
  ],
  [
    "BITM 534",
    "Field Study in Information Systems and Business Analytics",
    "University at Albany · course development · 2022",
  ],
  [
    "INFO 646",
    "Digital Product Design (Advanced User Experience Design)",
    "Pratt Institute · course development · 2019",
  ],
  [
    "INFO 642",
    "Content Strategy",
    "Pratt Institute · course development · 2019",
  ],
];
const undergraduate = [
  [
    "BITM 330",
    "Improving Business Performance with Information Technologies",
    "University at Albany · 2021–2026 · in person and online",
  ],
  [
    "INF 401",
    "Case Studies in Digital Citizenship",
    "University at Albany · 2021–2026 · online",
  ],
  [
    "ISBA 434",
    "Business Analytics Practicum",
    "University at Albany · 2021, 2022, 2024–2026",
  ],
  [
    "INF 495",
    "Special Topics in Research, Applied and Experiential Learning",
    "University at Albany · 2021",
  ],
  ["INF 462/562", "Current Technologies in Web Design", "SUNY Online · 2020"],
  [
    "INF 108",
    "Programming for Problem Solving: Introduction to Python",
    "University at Albany and SUNY Online · 2017–2023",
  ],
  [
    "INF 308",
    "Programming for Informatics: Advanced Python",
    "University at Albany · 2017–2021",
  ],
  [
    "INF 496",
    "UX in E-Commerce: Principles, Methods, and Technologies",
    "Academic College of Tel Aviv-Yaffo and University at Albany · 2017–2020",
  ],
  [
    "INF 200",
    "Research Methods for Information Studies",
    "University at Albany · 2018–2019",
  ],
  ["INF 100", "Information in the 21st Century", "University at Albany · 2019"],
  [
    "",
    "Database Management and Programming",
    "Academic College of Tel Aviv-Yaffo · 2017",
  ],
];
---

<Layout
  title="Teaching | Databases, Analytics and Programming"
  description="Courses and teaching materials by Nim Dvir in databases, business analytics, programming, and AI, including University at Albany course history and direction of UAlbany's Undergraduate Certificate in Business Analytics."
>
  <header class="page-intro">
    <h1>Teaching</h1>
    <p class="lede">
      I teach undergraduate and graduate courses in information systems,
      business analytics, databases, and programming, and I direct UAlbany’s
      <a href="/business-analytics-certificate/">Undergraduate Certificate in
      Business Analytics</a>. I also advise student research and design
      projects.
    </p>
    <img
      class="hero-image"
      src="https://res.cloudinary.com/dkndq6lyz/image/upload/f_auto,q_auto,w_1600,c_limit/v1795465095/PersonalSite/Portfolio/teaching/lecture/lecture-hall.jpg"
      alt="Nim Dvir teaching a large lecture class"
      width="1600"
      height="1066"
    />
  </header>
  <SectionMenu items={menu} label="Teaching sections" />
  <section class="section band band-white" id="courses">
    <h2>Courses</h2>
    <p>
      My current teaching includes BITM 330 and Digital Citizenship. The lists
      below include earlier courses and course development, with dates for each.
    </p>
    <h3>Graduate and MBA</h3>
    <ul class="course-list">
      {graduate.map(([code, title, context]) => (
        <li>
          <p class="status-label">{code}</p>
          <strong>{title}</strong>
          <span>{context}</span>
        </li>
      ))}
    </ul>
    <h3>Undergraduate</h3>
    <ul class="course-list">
      {undergraduate.map(([code, title, context]) => (
        <li>
          {code && <p class="status-label">{code}</p>}
          <strong>{title}</strong>
          <span>{context}</span>
        </li>
      ))}
    </ul>
    <a href={cvUrl}>Full teaching history</a>
  </section>
  <section class="section band band-dark" id="business-analytics-certificate">
    <h2>Program director, Undergraduate Certificate in Business Analytics</h2>
    <div class="prose">
      <p>
        I direct the Undergraduate Certificate in Business Analytics at the
        Massry School of Business. It’s a 15-credit, five-course credential in
        spreadsheet analysis, statistics, databases and SQL, and predictive
        analytics, and it’s open to qualified UAlbany students in any major.
        Students who complete it earn a University at Albany certificate and a
        notation on their transcript.
      </p>
      <p>
        I run the program from first conversation to award: outreach in
        classes before registration, admissions and eligibility review, advising
        students on the course sequence, and certifying graduates with the
        Registrar. I also teach BITM 330, the certificate’s database and SQL
        course.
      </p>
      <a class="button" href="/business-analytics-certificate/">
        Certificate courses, timeline and application
      </a>
    </div>
  </section>
  <section class="section band band-soft" id="courseware">
    <h2>Textbook and courseware</h2>
    <div class="prose">
      <h3>Using Data to Drive Business Performance</h3>
      <p>
        I’m writing a textbook on databases, SQL, business analytics, and
        information systems. The companion website includes explanations,
        exercises, and quizzes used in BITM 330.
      </p>
      <p class="small">
        The manuscript is under review with Cengage Learning, as reported in my
        September 2026 CV.
      </p>
      <a class="button" href="https://database-textbook.dimapublishing.com/">
        Open courseware ↗
      </a>
    </div>
  </section>
  <section class="split-section band band-white" id="student-projects">
    <h2>Assignments and student projects</h2>
    <div class="prose">
      <p>
        Students work on database queries, data analysis, user research, and
        prototypes. In the Business Analytics Practicum and graduate Field
        Study, teams work on questions from organizations and present their
        research and recommendations.
      </p>
      <p>
        The portfolio includes student projects I advised, including{" "}
        <a href="/projects/costco-mobile-app/">a shopping-app concept</a>,{" "}
        <a href="/projects/dexcom-g7-plus/">research on a diabetes app</a>, and{" "}
        <a href="/projects/barrier-free-living/">
          content recommendations for a nonprofit
        </a>
        .
      </p>
      <a class="text-link" href="/research/#projects">
        View projects
      </a>
    </div>
  </section>
  <section class="split-section band band-dark" id="student-feedback">
    <h2>Student feedback</h2>
    <div class="prose">
      <p>Some of what students have said about my courses.</p>
      <blockquote>
        <p>
          “I really appreciated the way Dr. Dvir connected course material to
          the broader trends in tech and business, which helped me better
          understand how to apply these concepts in my own career.”
        </p>
        <p class="small">BITM 330</p>
      </blockquote>
      <blockquote>
        <p>
          “Initially, the project felt daunting, but with Prof. Dvir’s support
          and guidance, it became far more approachable than I anticipated. I
          am genuinely thankful for the way you pushed us while still making
          the process exciting and achievable.”
        </p>
        <p class="small">BITM 522</p>
      </blockquote>
      <blockquote>
        <p>
          “This class has been the most challenging yet rewarding experience of
          my MBA program at UAlbany (and I only have two more classes left!).”
        </p>
        <p class="small">BITM 522</p>
      </blockquote>
      <blockquote>
        <p>
          “Thank you for your unwavering support and for being such a valued
          and appreciated educator. I’m incredibly grateful to have taken your
          course and excited for the final presentations next week!”
        </p>
        <p class="small">BITM 434</p>
      </blockquote>
      <div class="gallery">
        <a href="https://res.cloudinary.com/dkndq6lyz/image/upload/f_auto,q_auto/v1795465096/PersonalSite/Portfolio/teaching/student-feedback/thank-you-cards.jpg">
          <img
            src="https://res.cloudinary.com/dkndq6lyz/image/upload/f_auto,q_auto,w_900,c_limit/v1795465096/PersonalSite/Portfolio/teaching/student-feedback/thank-you-cards.jpg"
            alt="Two thank-you cards from students"
            loading="lazy"
          />
        </a>
        <img
          src="https://res.cloudinary.com/dkndq6lyz/image/upload/f_auto,q_auto/v1795465098/PersonalSite/Portfolio/teaching/student-feedback/lecture-hall-clip.gif"
          alt="Short clip of Nim Dvir in a full lecture hall"
          loading="lazy"
        />
      </div>
    </div>
  </section>
  <section class="split-section band band-soft" id="online-teaching">
    <h2>Online teaching</h2>
    <div class="prose">
      <p>
        I’m developing the fully asynchronous BITM 330 course for UAlbany’s
        Online BSBA program. I’ve also taught BITM 522 and Digital Citizenship
        online.
      </p>
    </div>
  </section>
  <section class="split-section band band-white" id="ai-in-coursework">
    <h2>AI in coursework</h2>
    <div class="prose">
      <p>
        My assignments include AI-assisted coding and evaluation of model
        outputs. Students are asked to explain their approach and assess the
        results they submit.
      </p>
      <p>
        I’m also preparing{" "}
        <a href="/research/ai-pedagogy/">research on AI and student learning</a>
        , including AI-assisted summarization and academic advising.
      </p>
    </div>
  </section>
  <section class="split-section band band-soft" id="workshops">
    <h2>Workshops</h2>
    <div class="prose">
      <h3>AI Agents in VS Code for Academic Work</h3>
      <p class="small">
        Cengage Computing Experience · October 21–23, 2026 · Fort Lauderdale,
        Florida
      </p>
      <p>
        This session covers files, project instructions, prompts, and using AI
        agents for academic work. The examples include building websites and
        reviewing changes.
      </p>
      <div class="button-row">
        <a class="button" href="https://nimdvir.github.io/cce-2026/">
          Session materials ↗
        </a>
        <a class="button" href="https://github.com/nimdvir/cce-2026">
          GitHub repository ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
