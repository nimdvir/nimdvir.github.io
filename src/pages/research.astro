---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const toAssetPath = (image?: string) => {
	if (!image || image.trim().startsWith('url(')) {
		return undefined;
	}

	return image;
};

const researchEntries = await getCollection('research');
const publicationEntries = await getCollection('publications');
const talkEntries = await getCollection('talks');

const researchProjects = researchEntries.sort((left, right) => {
	const featuredDelta = Number(right.data.featured ?? false) - Number(left.data.featured ?? false);
	if (featuredDelta !== 0) {
		return featuredDelta;
	}

	const orderDelta = (left.data.sortOrder ?? 999) - (right.data.sortOrder ?? 999);
	return orderDelta !== 0 ? orderDelta : right.data.year.localeCompare(left.data.year);
});

const featuredResearch = researchProjects.filter((entry) => entry.data.featured);
const additionalResearch = researchProjects.filter((entry) => !entry.data.featured);
const publications = [...publicationEntries].sort((left, right) => {
	const orderDelta = (left.data.sortOrder ?? 999) - (right.data.sortOrder ?? 999);
	return orderDelta !== 0 ? orderDelta : right.data.year.localeCompare(left.data.year);
});
const talks = [...talkEntries].sort((left, right) => {
	const orderDelta = (left.data.sortOrder ?? 999) - (right.data.sortOrder ?? 999);
	return orderDelta !== 0 ? orderDelta : right.data.year.localeCompare(left.data.year);
});
const researchInterestKeywords = [
	'Artificial Intelligence',
	'Machine Learning',
	'User Experience',
	'Ethics of AI',
	'Human-Computer Interaction',
	'Decision-Making',
	'Digital Learning',
	'Computational Linguistics',
	'Information Behavior',
	'Behavioral Economics',
	'Natural Language Processing (NLP)',
	'Content Strategy',
	'Design Research',
	'Computers and Society',
];

const manuscriptsInPreparation = [
	'Predicting information engagement using computational linguistics and NLP (under review).',
	'The Ways of Words: Impact of word choice on engagement and decision making.',
	'Phrasing for Success: Optimizing information engagement with AI and computational linguistics.',
	'Unified understanding of information engagement: literature review across HCI and behavior.',
	'Teaching IT and product design in MBA programs: qualitative exploration.',
];

const publicationSeeds = [
	'Sticky Words: A Computational Linguistics Approach to Assessment and Manipulation of Information Engagement (Doctoral dissertation, 2022).',
	'Process of information engagement: Integrating information behavior and user engagement. Proceedings of ASIS&T, 57(1), 2020.',
	'Systematic improvement of user engagement with academic titles using computational linguistics. Informing Science and IT Education Conference, 2019.',
	'When less is more: Consumer behavior and information sharing on landing pages. Informing Science, 2018.',
	'What is user engagement? Interdisciplinary perspective on interactions with IT, 2018.',
];

const talkSeeds = [
	'Does phrasing matter? Using generative text to improve information engagement and UX. ILAIS 2023.',
	'What do users read? Predictive models of information engagement. ILAIS 2021.',
	'Sticky words: linguistic analysis for better information interactions. ICIS / ASIS&T 2018.',
	'Less is more: digital content volume and engagement. UXPA International / Informing Science, 2018.',
];

const glance = [
	{ value: `${researchProjects.length}`, label: 'Research projects' },
	{ value: `${featuredResearch.length}`, label: 'Featured projects' },
	{ value: `${publications.length || publicationSeeds.length}`, label: 'Publications & manuscripts' },
	{ value: `${talks.length || talkSeeds.length}`, label: 'Talks' },
	{ value: 'Methods', label: 'NLP, HCI, design research' },
	{ value: 'Focus', label: 'AI, information behavior, teaching' },
];
---

<Layout
	title="Research"
	description="UX and AI research: information engagement, computational linguistics, and responsible AI."
>
	<div class="research-hero">
		<div id="particles-header"></div>
		<div class="hero-inner">
			<h1>Research</h1>
			<p class="hero-copy">
				Research at the intersection of information engagement, computational linguistics, responsible AI,
				and pedagogy.
			</p>
			<p class="hero-subtitle"><i class="fas fa-bolt"></i> At a Glance</p>
			<ul class="glance-strip">
				{glance.map((item) => (
					<li>
						<span class="glance-value">{item.value}</span>
						<span class="glance-label">{item.label}</span>
					</li>
				))}
			</ul>
		</div>
	</div>

	<script is:inline src={`${import.meta.env.BASE_URL}js/particles.js`}></script>
	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			if (typeof particlesJS !== 'undefined') {
				particlesJS('particles-header', {
					particles: {
						number: { value: 60, density: { enable: true, value_area: 800 } },
						color: { value: '#ffffff' },
						shape: { type: 'circle' },
						opacity: { value: 0.5, random: true },
						size: { value: 3, random: true },
						line_linked: { enable: true, distance: 150, color: '#ffffff', opacity: 0.3, width: 1 },
						move: { enable: true, speed: 1, direction: 'none', random: true, straight: false, out_mode: 'out' }
					},
					interactivity: {
						detect_on: 'canvas',
						events: { onhover: { enable: true, mode: 'grab' }, onclick: { enable: true, mode: 'push' }, resize: true },
						modes: { grab: { distance: 140, line_linked: { opacity: 1 } }, push: { particles_nb: 4 } }
					},
					retina_detect: true
				});
			}
		});
	</script>

	<section class="pillars-section" style="max-width: 1100px; margin: 0 auto 48px; padding: 0 24px;">
		<p style="color: #475569; font-size: 16px; line-height: 1.7; margin: 0 0 24px; max-width: 700px;">My research agenda centers on three interconnected pillars:</p>
		<div class="pillars-grid">
			<article class="pillar">
				<div class="pillar-icon"><i class="fas fa-brain"></i></div>
				<h3>Analytics + AI for Business</h3>
				<p>Solving organizational problems through NLP, machine learning, and behavioral analytics — from predicting user engagement to optimizing decision making with AI.</p>
			</article>
			<article class="pillar">
				<div class="pillar-icon"><i class="fas fa-laptop-code"></i></div>
				<h3>Information Systems Design</h3>
				<p>Studying how people interact with information systems in real-world settings — and designing products that are trustworthy, usable, and evidence-based.</p>
			</article>
			<article class="pillar">
				<div class="pillar-icon"><i class="fas fa-graduation-cap"></i></div>
				<h3>AI/ML Pedagogy</h3>
				<p>Developing curricula and teaching approaches that prepare students to use AI tools responsibly and effectively — from Python to LLMs.</p>
			</article>
		</div>
	</section>

	<section class="split">
		<div>
			<h2><i class="fas fa-lightbulb"></i> Research interests</h2>
			<ul class="keyword-list">
				{researchInterestKeywords.map((keyword) => (
					<li>{keyword}</li>
				))}
			</ul>
		</div>
		<div>
			<h2><i class="fas fa-tools"></i> Toolkits & methods</h2>
			<ul>
				<li><i class="fas fa-angle-right"></i> Usability studies, contextual inquiry, surveys</li>
				<li><i class="fas fa-angle-right"></i> Python + NLP (spaCy, NLTK), data science (pandas, scikit-learn)</li>
				<li><i class="fas fa-angle-right"></i> Design research, content strategy, qualitative + quantitative analysis</li>
			</ul>
		</div>
	</section>

	<section class="featured-section">
		<div class="section-head">
			<div>
				<p class="section-label">Featured research</p>
				<h2>Legacy-backed foundations and current research directions</h2>
			</div>
			<a href={withBase('/research/')}>Browse research archive</a>
		</div>
		<div class="research-grid">
			{featuredResearch.map((entry) => (
				<article class="research-card">
					{toAssetPath(entry.data.image) && (
						<a href={withBase(`/research/${entry.slug}/`)}>
							<img src={withBase(toAssetPath(entry.data.image)!)} alt={entry.data.title} loading="lazy" />
						</a>
					)}
					<div class="research-card__body">
						<p class="card-meta">{entry.data.year}{entry.data.subtitle ? ` · ${entry.data.subtitle}` : ''}</p>
						<h3><a href={withBase(`/research/${entry.slug}/`)}>{entry.data.title}</a></h3>
						<p>{entry.data.summary}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	{additionalResearch.length > 0 && (
		<section class="archive-section">
			<div class="section-head compact">
				<div>
					<p class="section-label">Additional research</p>
					<h2>Current and emerging work</h2>
				</div>
			</div>
			<ul class="archive-list">
				{additionalResearch.map((entry) => (
					<li>
						<a href={withBase(`/research/${entry.slug}/`)}>{entry.data.title}</a>
						<span>{entry.data.year}</span>
					</li>
				))}
			</ul>
		</section>
	)}

	<section class="lists">
		<details class="collapsible-section">
			<summary>
				<h2><i class="fas fa-file-alt"></i> Manuscripts in preparation</h2>
				<span class="chevron" aria-hidden="true"></span>
			</summary>
			<div class="list-content">
				<ol>
					{manuscriptsInPreparation.map((item) => <li>{item}</li>)}
				</ol>
			</div>
		</details>
	</section>

	<section class="lists">
		<details class="collapsible-section">
			<summary>
				<h2><i class="fas fa-book"></i> Selected publications</h2>
				<span class="chevron" aria-hidden="true"></span>
			</summary>
			<div class="list-content">
				{publications.length > 0 ? (
					<ul class="pubs">
						{publications.map((entry) => (
							<li>
								<i class="fas fa-scroll"></i> {entry.data.title}. {entry.data.venue}, {entry.data.year}.
							</li>
						))}
					</ul>
				) : (
					<ul class="pubs">
						{publicationSeeds.map((item) => (
							<li><i class="fas fa-scroll"></i> {item}</li>
						))}
					</ul>
				)}
			</div>
		</details>
	</section>

	<section class="lists">
		<details class="collapsible-section">
			<summary>
				<h2><i class="fas fa-microphone"></i> Recent talks</h2>
				<span class="chevron" aria-hidden="true"></span>
			</summary>
			<div class="list-content">
				{talks.length > 0 ? (
					<ul class="pubs">
						{talks.map((entry) => (
							<li>
								<i class="fas fa-comments"></i> {entry.data.title}. {entry.data.event}, {entry.data.year}.
							</li>
						))}
					</ul>
				) : (
					<ul class="pubs">
						{talkSeeds.map((item) => (
							<li><i class="fas fa-comments"></i> {item}</li>
						))}
					</ul>
				)}
			</div>
		</details>
	</section>
</Layout>

<style>
	/* ===== HERO ===== */
	.research-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -24px;
		background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
		padding: 60px 24px 72px;
		margin-bottom: 48px;
		color: #fff;
		overflow: hidden;
	}

	#particles-header {
		position: absolute;
		top: 0; left: 0;
		width: 100%; height: 100%;
		z-index: 1;
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 1100px;
		margin: 0 auto;
		text-align: center;
	}

	.hero-inner h1 {
		font-size: 56px;
		font-weight: 800;
		margin: 0 0 12px;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.hero-copy {
		max-width: 720px;
		margin: 0 auto 18px;
		font-size: 18px;
		line-height: 1.7;
		color: rgba(255,255,255,0.82);
	}

	.hero-subtitle {
		font-size: 16px;
		font-weight: 600;
		margin: 0 0 28px;
		color: rgba(255,255,255,0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}
	.hero-subtitle i { color: #fbbf24; }

	.glance-strip {
		list-style: none;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 12px;
		max-width: 960px;
	}

	.glance-strip li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		padding: 16px 10px;
		border-radius: 14px;
		background: rgba(0,0,0,0.22);
		border: 1px solid rgba(255,255,255,0.08);
	}

	.glance-value { font-weight: 700; font-size: 18px; color: #fff; }
	.glance-label { font-size: 12px; color: rgba(255,255,255,0.6); line-height: 1.3; text-align: center; }

	/* ===== CONTENT ===== */
	.split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 18px;
		margin-top: 24px;
	}

	h2 {
		margin: 0 0 10px;
		letter-spacing: -0.01em;
	}

	ul,
	ol {
		margin: 0;
		padding-left: 18px;
		color: #111827;
		line-height: 1.5;
		display: grid;
		gap: 10px;
	}

	.split ul {
		list-style: none;
		padding-left: 0;
	}

	.keyword-list {
		list-style: none;
		padding-left: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.keyword-list li {
		padding: 8px 12px;
		border-radius: 999px;
		background: #eff6ff;
		color: #1e3a5f;
		font-weight: 600;
	}

	.split ul li i {
		color: #1e3a5f;
		margin-right: 8px;
	}

	.featured-section,
	.archive-section {
		margin-top: 36px;
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 16px;
		margin-bottom: 18px;
	}

	.section-head a {
		color: #1d4ed8;
		font-weight: 700;
		text-decoration: none;
	}

	.section-label {
		margin: 0 0 6px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 12px;
		font-weight: 700;
		color: #64748b;
	}

	.section-head h2 {
		margin: 0;
		font-size: 26px;
	}

	.research-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 18px;
	}

	.research-card {
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 18px;
		overflow: hidden;
		box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
	}

	.research-card img {
		display: block;
		width: 100%;
		height: 180px;
		object-fit: cover;
	}

	.research-card__body {
		padding: 18px;
		display: grid;
		gap: 10px;
	}

	.card-meta {
		margin: 0;
		font-size: 13px;
		color: #64748b;
	}

	.research-card__body h3 {
		margin: 0;
		font-size: 22px;
		letter-spacing: -0.02em;
	}

	.research-card__body h3 a {
		text-decoration: none;
	}

	.research-card__body p {
		margin: 0;
		color: #334155;
		line-height: 1.6;
	}

	.archive-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 12px;
	}

	.archive-list li {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 16px;
		border-radius: 14px;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
	}

	.archive-list a {
		text-decoration: none;
		font-weight: 700;
	}

	.archive-list span {
		color: #64748b;
		font-weight: 600;
	}

	.pubs {
		list-style: none;
		padding-left: 0;
	}

	.pubs li i {
		color: #6b7280;
		margin-right: 10px;
	}

	.lists {
		margin-top: 28px;
	}

	.collapsible-section {
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 14px;
		overflow: hidden;
	}

	.collapsible-section summary {
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 16px 18px;
		cursor: pointer;
	}

	.collapsible-section summary::-webkit-details-marker {
		display: none;
	}

	.collapsible-section summary h2 {
		margin: 0;
		font-size: 22px;
	}

	.collapsible-section .chevron {
		width: 10px;
		height: 10px;
		border-right: 2px solid #94a3b8;
		border-bottom: 2px solid #94a3b8;
		transform: rotate(45deg);
		transition: transform 0.2s ease;
		flex-shrink: 0;
	}

	.collapsible-section[open] .chevron {
		transform: rotate(-135deg);
	}

	.list-content {
		border-top: 1px solid #e5e7eb;
		padding: 14px 18px 18px;
	}

	@media (max-width: 640px) {
		.research-hero { padding: 40px 16px 48px; }
		.hero-inner h1 { font-size: 40px; }
		.hero-copy { font-size: 16px; }
		.glance-strip { grid-template-columns: repeat(2, 1fr); }
		.section-head,
		.archive-list li {
			flex-direction: column;
			align-items: start;
		}

		h1 {
			font-size: 26px;
		}

		.lede {
			font-size: 16px;
		}
	}

	/* Research pillars */
	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
		gap: 20px;
	}

	.pillar {
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		padding: 28px 24px;
		box-shadow: 0 8px 24px rgba(0,0,0,0.04);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.pillar:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 36px rgba(0,0,0,0.08);
	}

	.pillar-icon {
		width: 48px; height: 48px;
		border-radius: 14px;
		background: linear-gradient(135deg, #1e3a5f, #2d5a8e);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 16px;
	}
	.pillar-icon i { color: #fff; font-size: 20px; }

	.pillar h3 {
		font-size: 18px;
		margin: 0 0 8px;
		color: #0f172a;
	}
	.pillar p {
		margin: 0;
		color: #475569;
		line-height: 1.6;
		font-size: 15px;
	}
</style>
