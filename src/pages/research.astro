---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { verifiedResearch, cvUrl } from "../data/profile";
const research = (await getCollection("research"))
  .filter((e) => verifiedResearch.includes(e.slug))
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
const publications = (await getCollection("publications")).sort((a, b) =>
  b.data.year.localeCompare(a.data.year),
);
const manuscripts = [
  [
    "The ways of words: The impact of word choice on information engagement and decision making",
    "Decision Support Systems · under review",
    "https://doi.org/10.48550/arXiv.2305.09798",
  ],
  [
    "Words that stick: Predicting decision making and synonym engagement using cognitive biases and computational linguistics",
    "The Journal of Computational Creativity · under review",
    "https://doi.org/10.48550/arXiv.2307.14511",
  ],
  [
    "A predictive model of digital information engagement",
    "Cognitive Computation · under review",
    "https://doi.org/10.48550/arXiv.2307.14500",
  ],
  [
    "Trust, credibility, or complexity? The effect of transparency in online marketing",
    "Journal of Interactive Marketing · under review",
    "https://doi.org/10.13140/RG.2.2.14206.56642",
  ],
  [
    "The double-edged screen: Balancing benefits and risks of social media in digital citizenship",
    "With M. R. Heslin · Computers in Human Behavior · under review",
    "https://doi.org/10.2139/ssrn.4701695",
  ],
  [
    "Beyond compliance: Digital accessibility as a strategic imperative for New York businesses",
    "With K. Putnam · Business & Society · under review",
    "",
  ],
];
---

<Layout
  title="Research"
  description="Nim Dvir’s research on information engagement, computational linguistics, human-centered AI, legal language, and digital learning."
>
  <header class="page-intro">
    <p class="eyebrow">Research / Human-centered technology</p>
    <h1>
      How information
      <br />
      <span class="gradient-text">moves people.</span>
    </h1>
    <p class="lede">
      I study how language and digital design shape engagement, understanding,
      and decisions, combining human-computer interaction with computational
      linguistics and behavioral research.
    </p>
  </header>
  <section class="feature-panel" aria-labelledby="funded-title">
    <div>
      <p class="eyebrow">Current funded research · 2026</p>
      <h2 id="funded-title">Language in mental health treatment courts.</h2>
      <p>
        With Nevada’s Eighth Judicial District Court, I’m examining how legal
        language framing relates to participant comprehension, compliance, and
        engagement.
      </p>
      <a class="text-link" href="/research/words-on-trial/">
        Explore the project ↗
      </a>
    </div>
    <div>
      <p class="status-label">Faculty Research Award Program · Category B</p>
      <h3>Behavioral design meets NLP.</h3>
      <p>
        Supported by a $3,242 UAlbany FRAP-B award in Spring 2026. The work
        combines language analysis and applied predictive modeling in a
        consequential real-world setting.
      </p>
    </div>
  </section>
  <section class="section" style="border-top:0">
    <div class="section-head">
      <div>
        <p class="eyebrow">Research agenda</p>
        <h2>Connected questions.</h2>
      </div>
    </div>
    <div class="research-grid">
      {research.map((r) => (
        <article class="plain-card">
          <p class="eyebrow">{r.data.category}</p>
          <h3>
            <a href={`/research/${r.slug}/`}>{r.data.title}</a>
          </h3>
          <p>{r.data.summary}</p>
          <span class="status-label">{r.data.status}</span>
        </article>
      ))}
    </div>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Selected scholarship</p>
      <h2>
        Published work
        <br />
        and dissertation.
      </h2>
      <p class="small">
        Publication details and links are drawn from the September 2026 CV.
      </p>
      <a
        class="text-link"
        href="https://scholar.google.com/citations?user=vzFELz4AAAAJ&hl=en"
      >
        Google Scholar ↗
      </a>
    </div>
    <ul class="reading-list">
      {publications.map((p) => (
        <li>
          <span class="status-label">
            {p.data.year} · {p.data.type || "Publication"}
          </span>
          <h3>
            {p.data.url ? (
              <a href={p.data.url}>{p.data.title} ↗</a>
            ) : (
              p.data.title
            )}
          </h3>
          <p>
            {p.data.authors.join(", ")} · <em>{p.data.venue}</em>
          </p>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Ongoing scholarship</p>
      <h2>
        Working papers
        <br />
        and manuscripts.
      </h2>
      <p class="small">
        Status as reported in the September 16, 2026 CV. Preprint links are
        provided where available; review status does not mean acceptance.
      </p>
    </div>
    <ul class="reading-list">
      {manuscripts.map(([title, status, url]) => (
        <li>
          <span class="status-label">{status}</span>
          <h3>{url ? <a href={url}>{title} ↗</a> : title}</h3>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section">
    <div>
      <p class="eyebrow">Conversations</p>
      <h2>
        Talks and
        <br />
        collaboration.
      </h2>
    </div>
    <div class="prose">
      <p>
        I’ve presented at ICIS, AMCIS, ASIS&T, UXPA, and ILAIS. My invited CCE
        2026 session explores AI agents for academic workflows.
      </p>
      <p>
        I welcome collaborators working on human-centered AI, language and
        decision-making, digital accessibility, and information systems
        education.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="mailto:ndvir@albany.edu">
          Discuss research ↗
        </a>
        <a class="button" href={cvUrl}>
          Full publication and talk list ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
