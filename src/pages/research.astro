---
import Layout from "../layouts/Layout.astro";
import TopicTicker from "../components/TopicTicker.astro";
import SectionMenu from "../components/SectionMenu.astro";
import { topicsIn } from "../utils/tags";
import { getCollection } from "astro:content";
import { getPublications } from "../utils/publications";
import { verifiedResearch, cvUrl } from "../data/profile";
const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99),
);
const categories = [...new Set(projects.map((p) => p.data.category))];
const research = (await getCollection("research"))
  .filter((e) => verifiedResearch.includes(e.slug))
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
const allPublications = await getPublications();
const publications = allPublications.filter(
  (entry) => !entry.data.workingPaper,
);
const workingPapers = allPublications.filter(
  (entry) => entry.data.workingPaper,
);
const topics = await topicsIn(["Research", "Publications"]);
const menu = [
  { id: "current-research", label: "Current research" },
  { id: "research-projects", label: "Research projects" },
  { id: "projects", label: "Design and UX projects" },
  { id: "publications", label: "Publications" },
  { id: "working-papers", label: "Working papers" },
  { id: "talks", label: "Talks" },
];
const manuscripts = [
  [
    "Trust, credibility, or complexity? The effect of transparency in online marketing",
    "Journal of Interactive Marketing · under review",
    "https://doi.org/10.13140/RG.2.2.14206.56642",
  ],
  [
    "The double-edged screen: Balancing benefits and risks of social media in digital citizenship",
    "With M. R. Heslin · Computers in Human Behavior · under review",
    "https://doi.org/10.2139/ssrn.4701695",
  ],
  [
    "Beyond compliance: Digital accessibility as a strategic imperative for New York businesses",
    "With K. Putnam · Business & Society · under review",
    "",
  ],
];
// Research card pictures: crop a Cloudinary image to the card's 16:10 frame.
const cardCrop = (src: string) =>
  src.replace(
    /\/image\/upload\/[^/]*c_limit\//,
    "/image/upload/f_auto,q_auto,w_720,h_450,c_fill,g_auto/",
  );
---

<Layout
  title="Research and Projects | Language, Information Engagement and UX"
  description="Research by Nim Dvir on language, information engagement, digital learning, and decision-making, with his UX research and design projects and student projects he advised."
>
  <header class="page-intro intro-with-topics">
    <div class="intro-text">
      <h1>Research and projects</h1>
      <p class="lede">
        My research examines how wording and the amount of information people
        receive affect their understanding, engagement, and decisions. I use
        experiments, user research, and computational analysis of language.
        The design and UX projects below come from the same questions, asked
        for clients, plus student projects I advised.
      </p>
    </div>
    <TopicTicker topics={topics} />
  </header>
  <SectionMenu items={menu} label="Research sections" />
  <section class="band band-dark" id="current-research" aria-labelledby="funded-title">
  <div class="feature-panel">
    <div>
      <p class="small">Current research · 2026</p>
      <h2 id="funded-title">Language in mental health treatment courts</h2>
      <p>
        With Nevada’s Eighth Judicial District Court, I’m studying how legal
        language relates to participant comprehension, compliance, and
        engagement.
      </p>
      <a class="text-link" href="/research/words-on-trial/">
        Project details
      </a>
    </div>
    <div>
      <h3>Research support</h3>
      <p>
        University at Albany Faculty Research Award Program, Category B: $3,242
        awarded in Spring 2026.
      </p>
    </div>
  </div>
  </section>
  <section class="section band band-white" id="research-projects">
    <div class="section-head">
      <div>
        <h2>Research projects</h2>
      </div>
    </div>
    <div class="research-grid">
      {research.map((r) => (
        <article class="plain-card research-card">
          {r.data.image && (
            <a class="research-card-visual" href={`/research/${r.slug}/`} tabindex="-1" aria-hidden="true">
              <img
                src={cardCrop(r.data.image)}
                alt={r.data.imageAlt ?? r.data.title}
                width="720"
                height="450"
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <p class="eyebrow">{r.data.category}</p>
          <h3>
            <a href={`/research/${r.slug}/`}>{r.data.title}</a>
          </h3>
          <p>{r.data.summary}</p>
          <span class="status-label">{r.data.status}</span>
        </article>
      ))}
    </div>
  </section>
  <section class="section band band-soft" id="projects" aria-labelledby="projects-heading">
    <div class="section-head">
      <div>
        <h2 id="projects-heading">Design and UX projects</h2>
        <p class="small archive-section-lede">
          Professional work in user research and design, and student projects I
          advised. Each page says what my role was.
        </p>
      </div>
    </div>
    <div class="project-filters" role="group" aria-label="Filter projects by category" hidden>
      <button class="filter-button" data-filter="all" aria-pressed="true">
        All projects
      </button>
      {categories.map((c) => (
        <button class="filter-button" data-filter={c} aria-pressed="false">
          {c}
        </button>
      ))}
    </div>
    <p id="filter-status" class="small" role="status" aria-live="polite">
      {projects.length} projects shown
    </p>
    <div class="project-grid">
      {projects.map((p, i) => (
        <article class="card" data-project-category={p.data.category}>
          <a
            class="card-visual contain"
            href={`/projects/${p.slug}/`}
            tabindex="-1"
            aria-hidden="true"
          >
            {p.data.image ? (
              <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width="640" height="400" loading="lazy" />
            ) : (
              <span class="project-monogram">
                {String(i + 1).padStart(2, "0")} / {p.data.title.slice(0, 2).toUpperCase()}
              </span>
            )}
          </a>
          <div class="card-body">
            <p class="eyebrow">{p.data.category}</p>
            <h3>
              <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
            </h3>
            <p>{p.data.summary}</p>
            {p.data.role && <p class="small">{p.data.role}</p>}
            <a class="text-link" href={`/projects/${p.slug}/`}>
              View project
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="split-section band band-white" id="publications">
    <div>
      <h2>Publications and dissertation</h2>
      <p class="small">
        Publication details are drawn from the September 2026 CV and original
        publication records.
      </p>
      <a
        class="text-link"
        href="https://scholar.google.com/citations?user=vzFELz4AAAAJ&hl=en"
      >
        Google Scholar ↗
      </a>
    </div>
    <ul class="reading-list">
      {publications.map((p) => (
        <li>
          <span class="status-label">
            {p.data.year} · {p.data.type || "Publication"}
          </span>
          <h3>
            {p.data.pageReady || p.data.url ? (
              <a
                href={
                  p.data.pageReady ? `/publications/${p.slug}/` : p.data.url
                }
              >
                {p.data.title}
                {!p.data.pageReady && " ↗"}
              </a>
            ) : (
              p.data.title
            )}
          </h3>
          <p>
            {p.data.authors.join(", ")} · <em>{p.data.venue}</em>
          </p>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section band band-soft" id="working-papers">
    <div>
      <h2>Working papers</h2>
      <p class="small">
        Manuscript status is from the September 2026 CV. Paper pages show the
        date and authors of the linked preprint.
      </p>
    </div>
    <ul class="reading-list">
      {workingPapers.map((paper) => (
        <li>
          <span class="status-label">
            {paper.data.year} · {paper.data.type}
          </span>
          <h3>
            <a href={`/publications/${paper.slug}/`}>{paper.data.title}</a>
          </h3>
          <p>{paper.data.authors.join(", ")}</p>
          {paper.data.manuscriptStatus && (
            <p class="small">{paper.data.manuscriptStatus}</p>
          )}
        </li>
      ))}
      {manuscripts.map(([title, status, url]) => (
        <li>
          <span class="status-label">{status}</span>
          <h3>{url ? <a href={url}>{title} ↗</a> : title}</h3>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section band band-dark" id="talks">
    <h2>Selected talks</h2>
    <div>
      <ul class="reading-list">
        <li>
          <p class="small">CCE · October 21–23, 2026 · Upcoming</p>
          <h3>
            <a href="https://nimdvir.github.io/cce-2026/">
              AI Agents in VS Code for Academic Work ↗
            </a>
          </h3>
        </li>
        <li>
          <p class="small">ILAIS · July 2023</p>
          <h3>
            Does phrasing matter? Using generative text to improve information
            engagement and user experience
          </h3>
        </li>
        <li>
          <p class="small">ILAIS · July 2021</p>
          <h3>
            What do users read? A predictive model of information engagement
          </h3>
        </li>
        <li>
          <p class="small">UXPA International · June 2018</p>
          <h3>
            Less is more: An empirical investigation of the relationship between
            amount of digital content and user engagement
          </h3>
        </li>
      </ul>
      <p>
        <a href={cvUrl}>Full publication and talk list</a>
      </p>
    </div>
  </section>
</Layout>
