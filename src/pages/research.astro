---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getPublications } from "../utils/publications";
import { verifiedResearch, cvUrl } from "../data/profile";
const research = (await getCollection("research"))
  .filter((e) => verifiedResearch.includes(e.slug))
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
const allPublications = await getPublications();
const publications = allPublications.filter(
  (entry) => !entry.data.workingPaper,
);
const workingPapers = allPublications.filter(
  (entry) => entry.data.workingPaper,
);
const manuscripts = [
  [
    "Trust, credibility, or complexity? The effect of transparency in online marketing",
    "Journal of Interactive Marketing · under review",
    "https://doi.org/10.13140/RG.2.2.14206.56642",
  ],
  [
    "The double-edged screen: Balancing benefits and risks of social media in digital citizenship",
    "With M. R. Heslin · Computers in Human Behavior · under review",
    "https://doi.org/10.2139/ssrn.4701695",
  ],
  [
    "Beyond compliance: Digital accessibility as a strategic imperative for New York businesses",
    "With K. Putnam · Business & Society · under review",
    "",
  ],
];
---

<Layout
  title="Research | Language and Information Engagement"
  description="Research by Nim Dvir on language, information engagement, digital learning, and decision-making."
>
  <header class="page-intro">
    <h1>Research</h1>
    <p class="lede">
      My research examines how wording and the amount of information people
      receive affect their understanding, engagement, and decisions. I use
      experiments, user research, and computational analysis of language.
    </p>
  </header>
  <section class="feature-panel" aria-labelledby="funded-title">
    <div>
      <p class="small">Current research · 2026</p>
      <h2 id="funded-title">Language in mental health treatment courts</h2>
      <p>
        With Nevada’s Eighth Judicial District Court, I’m studying how legal
        language relates to participant comprehension, compliance, and
        engagement.
      </p>
      <a class="text-link" href="/research/words-on-trial/">
        Project details
      </a>
    </div>
    <div>
      <h3>Research support</h3>
      <p>
        University at Albany Faculty Research Award Program, Category B: $3,242
        awarded in Spring 2026.
      </p>
    </div>
  </section>
  <section class="section" style="border-top:0">
    <div class="section-head">
      <div>
        <h2>Research projects</h2>
      </div>
    </div>
    <div class="research-grid">
      {research.map((r) => (
        <article class="plain-card">
          <p class="eyebrow">{r.data.category}</p>
          <h3>
            <a href={`/research/${r.slug}/`}>{r.data.title}</a>
          </h3>
          <p>{r.data.summary}</p>
          <span class="status-label">{r.data.status}</span>
        </article>
      ))}
    </div>
  </section>
  <section class="split-section">
    <div>
      <h2>Publications and dissertation</h2>
      <p class="small">
        Publication details are drawn from the September 2026 CV and original
        publication records.
      </p>
      <a
        class="text-link"
        href="https://scholar.google.com/citations?user=vzFELz4AAAAJ&hl=en"
      >
        Google Scholar ↗
      </a>
    </div>
    <ul class="reading-list">
      {publications.map((p) => (
        <li>
          <span class="status-label">
            {p.data.year} · {p.data.type || "Publication"}
          </span>
          <h3>
            {p.data.pageReady || p.data.url ? (
              <a
                href={
                  p.data.pageReady ? `/publications/${p.slug}/` : p.data.url
                }
              >
                {p.data.title}
                {!p.data.pageReady && " ↗"}
              </a>
            ) : (
              p.data.title
            )}
          </h3>
          <p>
            {p.data.authors.join(", ")} · <em>{p.data.venue}</em>
          </p>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section">
    <div>
      <h2>Working papers</h2>
      <p class="small">
        Manuscript status is from the September 2026 CV. Paper pages show the
        date and authors of the linked preprint.
      </p>
    </div>
    <ul class="reading-list">
      {workingPapers.map((paper) => (
        <li>
          <span class="status-label">
            {paper.data.year} · {paper.data.type}
          </span>
          <h3>
            <a href={`/publications/${paper.slug}/`}>{paper.data.title}</a>
          </h3>
          <p>{paper.data.authors.join(", ")}</p>
          {paper.data.manuscriptStatus && (
            <p class="small">{paper.data.manuscriptStatus}</p>
          )}
        </li>
      ))}
      {manuscripts.map(([title, status, url]) => (
        <li>
          <span class="status-label">{status}</span>
          <h3>{url ? <a href={url}>{title} ↗</a> : title}</h3>
        </li>
      ))}
    </ul>
  </section>
  <section class="split-section">
    <h2>Selected talks</h2>
    <div>
      <ul class="reading-list">
        <li>
          <p class="small">CCE · October 21–23, 2026 · Upcoming</p>
          <h3>
            <a href="https://nimdvir.github.io/cce-2026/">
              AI Agents in VS Code for Academic Work ↗
            </a>
          </h3>
        </li>
        <li>
          <p class="small">ILAIS · July 2023</p>
          <h3>
            Does phrasing matter? Using generative text to improve information
            engagement and user experience
          </h3>
        </li>
        <li>
          <p class="small">ILAIS · July 2021</p>
          <h3>
            What do users read? A predictive model of information engagement
          </h3>
        </li>
        <li>
          <p class="small">UXPA International · June 2018</p>
          <h3>
            Less is more: An empirical investigation of the relationship between
            amount of digital content and user engagement
          </h3>
        </li>
      </ul>
      <p>
        <a href={cvUrl}>Full publication and talk list</a>
      </p>
    </div>
  </section>
</Layout>
