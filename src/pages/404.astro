---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="Find your way back to Nim Dvir’s research, projects, and teaching."
  noindex={true}
>
  <section class="page-intro">
    <p class="eyebrow">404 / A small detour</p>
    <h1>
      This page
      <br />
      has wandered off.
    </h1>
    <p class="lede">
      The address may have changed. You can find my research, projects, and
      teaching through the navigation above.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/">
        Back to home ↗
      </a>
      <a class="button" href="/projects/">
        Explore projects ↗
      </a>
    </div>
  </section>
</Layout>
