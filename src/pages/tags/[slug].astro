---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { tagArchives, canonicalTags } from "../../utils/tags";
import { getArticles } from "../../utils/articles";

export async function getStaticPaths() {
  return (await tagArchives()).map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const collections = [...new Set(tag.entries.map((e) => e.collection))];
const groups = collections.map((name) => ({
  name,
  entries: tag.entries.filter((e) => e.collection === name),
}));
const count = tag.entries.length;
// Articles get picture cards; the other sections keep the dated list.
const allArticles = await getArticles();
const articleUrls = new Set(tag.entries.filter((e) => e.collection === "Articles").map((e) => e.url));
const tagArticles = allArticles
  .filter((a) => articleUrls.has(`/articles/${a.slug}/`))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
// Topics that most often appear alongside this one.
const related = new Map<string, { slug: string; label: string; n: number }>();
for (const e of tag.entries)
  for (const t of canonicalTags(e.tags)) {
    if (t.slug === tag.slug) continue;
    const cur = related.get(t.slug) ?? { slug: t.slug, label: t.label, n: 0 };
    cur.n += 1;
    related.set(t.slug, cur);
  }
const relatedTopics = [...related.values()].sort((a, b) => b.n - a.n || a.label.localeCompare(b.label)).slice(0, 10);
const description = tag.description
  ? `${tag.description} ${count} ${count === 1 ? "page" : "pages"} on this site are tagged ${tag.label}.`
  : `${count} ${count === 1 ? "page" : "pages"} on this site tagged ${tag.label}.`;
---

<Layout
  title={`${tag.label} · Topic`}
  description={description}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Topics", path: "/tags/" },
    { name: tag.label, path: `/tags/${tag.slug}/` },
  ]}
>
  <header class="page-intro">
    <a class="back-link" href="/tags/">← All topics</a>
    <p class="eyebrow" style="margin-top:20px">Topic</p>
    <h1>{tag.label}</h1>
    <p class="lede">
      {tag.description && <span>{tag.description} </span>}
      {count} {count === 1 ? "page" : "pages"} across {collections.length}{" "}
      {collections.length === 1 ? "section" : "sections"} of the site.
    </p>
  </header>

  {relatedTopics.length > 0 && (
    <nav class="related-topics" aria-label="Related topics">
      <p class="eyebrow">Often appears with</p>
      <ul class="tag-cloud">
        {relatedTopics.map((t) => (
          <li><a href={`/tags/${t.slug}/`}>{t.label}<span class="tag-count">{t.n}</span></a></li>
        ))}
      </ul>
    </nav>
  )}

  {groups.map((group) => (
    group.name === "Articles" && tagArticles.length > 0 ? (
    <section class="section tag-archive">
      <div class="section-head">
        <h2>Articles <span class="tag-section-count">{tagArticles.length}</span></h2>
      </div>
      <div class="project-grid article-grid grid-3">
        {tagArticles.map((article) => <ArticleCard article={article} headingLevel="h3" />)}
      </div>
    </section>
    ) : (
    <section class="section tag-archive">
      <div class="section-head">
        <h2>{group.name}</h2>
      </div>
      <ul class="dated-list tag-list">
        {group.entries.map((entry) => (
          <li>
            <span class="tag-list-date">{entry.date}</span>
            <div>
              <h3>
                <a href={entry.url}>{entry.title}</a>
              </h3>
              <p>{entry.summary}</p>
              <p class="post-meta">{entry.kind}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
    )
  ))}
</Layout>
