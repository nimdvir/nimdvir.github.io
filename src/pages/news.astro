---
import Layout from "../layouts/Layout.astro";
import NewsList from "../components/NewsList.astro";
import { getNews } from "../utils/editorial";
const news = await getNews();
const years = [...new Set(news.map((entry) => entry.data.date.slice(0, 4)))];
---

<Layout title="News" description="Dated updates from Nim Dvir.">
  <header class="page-intro editorial-intro">
    <h1>News</h1>
    <nav class="editorial-nav" aria-label="Writing and updates">
      <a href="/blog/">Blog</a>
      <a href="/news/" aria-current="page">
        News
      </a>
      <a href="/media/">Interviews</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </header>
  <div class="editorial-archive">
    {years.map((year) => (
      <section class="news-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <NewsList
          entries={news.filter((entry) => entry.data.date.startsWith(year))}
        />
      </section>
    ))}
    {!news.length && <p class="editorial-empty">No news yet.</p>}
  </div>
</Layout>
