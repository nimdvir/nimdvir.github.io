---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RelatedInterviews from '../../components/RelatedInterviews.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

export async function getStaticPaths() {
	const interviews = await getCollection('interviews');
	return interviews.map((interview) => ({
		params: { slug: interview.slug },
		props: { interview },
	}));
}

const { interview } = Astro.props;
const { Content } = await interview.render();
const heroImage = interview.data.heroImage ?? interview.data.image;
const heroImageSrc = heroImage && !heroImage.startsWith('http') ? withBase(heroImage) : heroImage;
const portraitImageSrc = interview.data.image && !interview.data.image.startsWith('http')
	? withBase(interview.data.image)
	: interview.data.image;
const citationDateMatch = interview.data.date.match(/^([A-Za-z]{3}) (\d{1,2}), (\d{4})$/);
const citationDate = citationDateMatch
	? `${citationDateMatch[3]}, ${citationDateMatch[1]} ${citationDateMatch[2]}`
	: interview.data.date;
const socialImage = heroImageSrc ?? portraitImageSrc;
const portraitAlt = interview.data.imageAlt ?? interview.data.title;
const heroAlt = interview.data.heroImageAlt ?? interview.data.title;
---

<Layout title={interview.data.title} description={interview.data.summary} image={socialImage}>
	<article class="interview">
		<header class="interview-header">
			<a href={withBase('/blog')} class="back-link"><i class="fas fa-arrow-left"></i> Back to Writing</a>
			<div class="meta">
				<span class="date"><i class="far fa-calendar"></i> {interview.data.date}</span>
				{interview.data.sourceUrl && (
					<span class="source">
						<i class="fas fa-newspaper"></i> 
						<a href={interview.data.sourceUrl} target="_blank" rel="noreferrer">{interview.data.source}</a>
					</span>
				)}
			</div>
			{interview.data.interviewee && (
				<p class="interview-label"><span class="highlight">Interview — {interview.data.interviewee}</span></p>
			)}
			<h1>{interview.data.title}</h1>
			<p class="byline">By <strong>Nimrod Dvir</strong></p>
			<div class="tags">
				{interview.data.tags.map((tag) => (
					<span class="tag">{tag}</span>
				))}
			</div>
		</header>

		{portraitImageSrc && (
			<figure class="media-figure portrait-figure">
				<img src={portraitImageSrc} alt={portraitAlt} class="portrait" />
				{interview.data.imageCaption && <figcaption class="media-caption">{interview.data.imageCaption}</figcaption>}
			</figure>
		)}

		{heroImageSrc && heroImageSrc !== portraitImageSrc && (
			<figure class="media-figure hero-figure">
				<img src={heroImageSrc} alt={heroAlt} class="hero" />
				{interview.data.heroImageCaption && <figcaption class="media-caption">{interview.data.heroImageCaption}</figcaption>}
			</figure>
		)}

		<div class="content">
			<Content />
		</div>

		{(interview.data.source || interview.data.sourceUrl) && (
			<div class="citation-block">
				<h3>Cite this article</h3>
				<p class="citation-text">
					Dvir, N. ({citationDate}). {interview.data.title}. <em>{interview.data.source}</em>.{' '}
					{interview.data.sourceUrl && (
						<a href={interview.data.sourceUrl} target="_blank" rel="noreferrer">{interview.data.sourceUrl}</a>
					)}
				</p>
			</div>
		)}

		<RelatedInterviews currentSlug={`interviews/${interview.slug}`} />
	</article>
</Layout>

<style>
	.interview {
		max-width: 760px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #6b7280;
		text-decoration: none;
		font-size: 14px;
		margin-bottom: 20px;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: #3b82f6;
	}

	.interview-header {
		margin-bottom: 32px;
	}

	.meta {
		display: flex;
		gap: 20px;
		font-size: 14px;
		color: #6b7280;
		margin-bottom: 12px;
	}

	.meta a {
		color: #3b82f6;
		text-decoration: none;
	}

	.meta a:hover {
		text-decoration: underline;
	}

	h1 {
		font-size: 36px;
		letter-spacing: -0.02em;
		margin: 0 0 12px;
		line-height: 1.2;
	}

	.interview-label {
		margin: 0 0 12px;
		font-size: 16px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.highlight {
		background: linear-gradient(90deg, #fde68a 0%, #fde68a 100%);
		background-size: 0% 45%;
		background-position: 0% 100%;
		background-repeat: no-repeat;
		padding: 2px 6px;
		animation: highlightSweep 3s ease-in-out infinite;
	}

	@keyframes highlightSweep {
		0% {
			background-size: 0% 45%;
			background-position: 0% 100%;
		}
		40% {
			background-size: 100% 45%;
			background-position: 0% 100%;
		}
		60% {
			background-size: 100% 45%;
			background-position: 0% 100%;
		}
		100% {
			background-size: 0% 45%;
			background-position: 100% 100%;
		}
	}

	.byline {
		color: #4b5563;
		margin: 0 0 16px;
	}

	.tags {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.tag {
		background: #ede9fe;
		color: #7c3aed;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
	}

	.media-figure {
		margin: 0 0 32px;
	}

	.portrait-figure {
		text-align: center;
	}

	.hero-figure {
		margin-bottom: 36px;
	}

	.portrait {
		width: 200px;
		height: 200px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid #e5e7eb;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}

	.hero {
		width: 100%;
		max-width: 100%;
		height: auto;
		max-height: 520px;
		object-fit: cover;
		border-radius: 18px;
		box-shadow: 0 16px 40px rgba(15, 23, 42, 0.14);
	}

	.media-caption {
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.6;
		color: #6b7280;
		text-align: center;
	}

	.content {
		font-size: 18px;
		line-height: 1.8;
		color: #1f2937;
	}

	.content :global(p:first-of-type) {
		font-size: 20px;
		color: #374151;
		border-left: 4px solid #3b82f6;
		padding-left: 20px;
		margin-bottom: 32px;
	}

	.content :global(h2) {
		font-size: 24px;
		margin: 40px 0 16px;
		letter-spacing: -0.01em;
	}

	.content :global(p) {
		margin: 0 0 16px;
	}

	.content :global(ul) {
		margin: 0 0 16px;
		padding-left: 24px;
	}

	.content :global(li) {
		margin-bottom: 8px;
	}

	.content :global(blockquote) {
		background: #f8fafc;
		border-left: 4px solid #7c3aed;
		padding: 20px 24px;
		margin: 24px 0;
		border-radius: 0 8px 8px 0;
		font-style: italic;
		color: #374151;
	}

	.content :global(figure) {
		margin: 32px 0;
	}

	.content :global(figure img) {
		width: 100%;
		max-width: 100%;
		height: auto;
		border-radius: 12px;
	}

	.content :global(figcaption) {
		margin-top: 10px;
		font-size: 14px;
		line-height: 1.6;
		color: #6b7280;
		text-align: center;
	}

	.content :global(hr) {
		margin: 48px 0 24px;
		border: none;
		border-top: 1px solid #e5e7eb;
	}

	.citation-block {
		background: #f9fafb;
		border: 1px solid #e5e7eb;
		border-radius: 8px;
		padding: 20px 24px;
		margin: 32px 0;
	}

	.citation-block h3 {
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #6b7280;
		margin: 0 0 10px;
	}

	.citation-text {
		font-size: 15px;
		line-height: 1.7;
		color: #374151;
		margin: 0;
		word-break: break-word;
	}

	.citation-text a {
		color: #3b82f6;
		text-decoration: none;
	}

	.citation-text a:hover {
		text-decoration: underline;
	}

	@media (max-width: 600px) {
		h1 {
			font-size: 28px;
		}

		.content {
			font-size: 16px;
		}

		.content :global(p:first-of-type) {
			font-size: 18px;
		}
	}
</style>
