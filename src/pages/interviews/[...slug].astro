---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RelatedInterviews from "../../components/RelatedInterviews.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

export async function getStaticPaths() {
  const interviews = await getCollection("interviews");
  return interviews.map((interview) => ({
    params: { slug: interview.slug },
    props: { interview },
  }));
}

const { interview } = Astro.props;
const { Content } = await interview.render();
---

<Layout title={interview.data.title} description={interview.data.summary}>
  <article class="interview">
    <header class="interview-header">
      <a href={withBase("/media/")} class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Media
      </a>
      <div class="meta">
        <span class="date">
          <i class="far fa-calendar"></i> {interview.data.date}
        </span>
        {interview.data.sourceUrl && (
          <span class="source">
            <i class="fas fa-newspaper"></i>
            <a href={interview.data.sourceUrl} target="_blank" rel="noreferrer">
              {interview.data.source}
            </a>
          </span>
        )}
      </div>
      {interview.data.interviewee && (
        <p class="interview-label">
          <span class="highlight">
            Interview — {interview.data.interviewee}
          </span>
        </p>
      )}
      <h1>{interview.data.title}</h1>
      <p class="byline">
        By <strong>Nimrod Dvir</strong>
      </p>
      <div class="tags">
        {interview.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    {interview.data.image && (
      <div class="hero-image">
        <img
          src={interview.data.image}
          alt={interview.data.title}
          class="portrait"
        />
      </div>
    )}

    <div class="content">
      <Content />
    </div>

    {(interview.data.source || interview.data.sourceUrl) && (
      <div class="citation-block">
        <h3>Cite this article</h3>
        <p class="citation-text">
          Dvir, N. (
          {(() => {
            const parts = interview.data.date.split(" ");
            const year = parts[2];
            const month = parts[0];
            const day = parts[1].replace(",", "");
            return `${year}, ${month} ${day}`;
          })()}
          ). {interview.data.title}. <em>{interview.data.source}</em>.{" "}
          {interview.data.sourceUrl && (
            <a href={interview.data.sourceUrl} target="_blank" rel="noreferrer">
              {interview.data.sourceUrl}
            </a>
          )}
        </p>
      </div>
    )}

    <RelatedInterviews currentSlug={`interviews/${interview.slug}`} />
  </article>
</Layout>
