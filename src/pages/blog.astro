---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../utils/editorial";
const posts = await getPosts();
---

<Layout
  title="Blog"
  description="Posts by Nim Dvir on research, teaching, and projects."
>
  <header class="page-intro editorial-intro">
    <h1>Blog</h1>
    <nav class="editorial-nav" aria-label="Writing and updates">
      <a href="/blog/" aria-current="page">
        Blog
      </a>
      <a href="/news/">News</a>
      <a href="/articles/">Articles</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </header>
  <section class="editorial-archive" aria-label="Blog posts">
    {posts.length ? (
      <PostList entries={posts} headingLevel="h2" />
    ) : (
      <div class="editorial-empty">
        <h2>No posts yet.</h2>
        <p>My translated journalism is in the articles archive.</p>
        <a class="text-link" href="/articles/">
          Browse the archive
        </a>
      </div>
    )}
  </section>
</Layout>
