---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../utils/editorial";
const posts = await getPosts();
---

<Layout
  title="Blog"
  description="Writing on research, teaching, UX, AI, and building useful things by Nim Dvir."
>
  <header class="page-intro editorial-intro">
    <p class="eyebrow">Blog / Longer reads</p>
    <h1>
      Ideas, <span class="gradient-text">in progress.</span>
    </h1>
    <p class="lede">
      Research, teaching, and the work of making technology useful.
    </p>
    <nav class="editorial-nav" aria-label="Writing and updates">
      <a href="/blog/" aria-current="page">
        Blog
      </a>
      <a href="/news/">News</a>
      <a href="/media/">Interviews</a>
    </nav>
  </header>
  <section class="editorial-archive" aria-label="Blog posts">
    {posts.length ? (
      <PostList entries={posts} headingLevel="h2" />
    ) : (
      <div class="editorial-empty">
        <h2>New posts will appear here.</h2>
        <p>In the meantime, explore my published interviews and journalism.</p>
        <a class="text-link" href="/media/">
          Read the interviews ↗
        </a>
      </div>
    )}
  </section>
</Layout>
