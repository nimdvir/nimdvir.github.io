---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const interviews = await getCollection("interviews");
---

<Layout
  title="Writing"
  description="Selected journalism and interviews by Nim Dvir."
>
  <header class="page-intro">
    <p class="eyebrow">Writing / Selected journalism</p>
    <h1>
      Questions that
      <br />
      <span class="gradient-text">open a conversation.</span>
    </h1>
    <p class="lede">
      Interviews and journalism from my work as an editor and correspondent.
    </p>
  </header>
  <ul class="reading-list">
    {interviews.map((i) => (
      <li>
        <span class="status-label">
          {i.data.source} · {i.data.date}
        </span>
        <h2 style="font-size:1.5rem">
          <a href={`/interviews/${i.slug}/`}>{i.data.title}</a>
        </h2>
        <p>{i.data.summary}</p>
      </li>
    ))}
  </ul>
  <div class="button-row">
    <a class="button" href="/media/">
      More media and interviews ↗
    </a>
  </div>
</Layout>
