---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const toAssetPath = (image?: string) => {
	if (!image || image.trim().startsWith('url(')) {
		return undefined;
	}

	return image;
};

const { currentSlug, heading = 'Related research' } = Astro.props;

const entries = await getCollection('research');
const related = entries
	.filter((entry) => entry.slug !== currentSlug)
	.sort((left, right) => {
		const featuredDelta = Number(right.data.featured ?? false) - Number(left.data.featured ?? false);
		if (featuredDelta !== 0) {
			return featuredDelta;
		}

		const orderDelta = (left.data.sortOrder ?? 999) - (right.data.sortOrder ?? 999);
		return orderDelta !== 0 ? orderDelta : right.data.year.localeCompare(left.data.year);
	})
	.slice(0, 3);
---

<section class="related">
	<div class="related-head">
		<h2>{heading}</h2>
		<a class="browse" href={withBase('/research')}>Browse all</a>
	</div>
	<div class="related-grid">
		{related.map((entry) => (
			<a class="card" href={withBase(`/research/${entry.slug}`)}>
				{toAssetPath(entry.data.image) && (
					<img class="thumb" src={withBase(toAssetPath(entry.data.image)!)} alt={entry.data.title} loading="lazy" />
				)}
				<div class="card-body">
					<p class="meta">{entry.data.year}{entry.data.subtitle ? ` · ${entry.data.subtitle}` : ''}</p>
					<h3>{entry.data.title}</h3>
					<p class="summary">{entry.data.summary}</p>
				</div>
			</a>
		))}
	</div>
</section>

<style>
	.related {
		margin-top: 48px;
		border-top: 1px solid #e5e7eb;
		padding-top: 28px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.related-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	h2 {
		margin: 0;
		font-size: 22px;
		letter-spacing: -0.01em;
	}

	.browse {
		font-weight: 700;
		text-decoration: none;
		color: #0f172a;
		transition: color 0.2s ease;
	}

	.browse:hover {
		color: #1e3a5f;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 14px;
	}

	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid #e5e7eb;
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		background: #ffffff;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 15px 30px rgba(0, 0, 0, 0.06);
	}

	.thumb {
		height: 120px;
		width: 100%;
		object-fit: cover;
	}

	.card-body {
		padding: 14px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.meta {
		margin: 0;
		color: #6b7280;
		font-size: 13px;
	}

	.summary {
		margin: 0;
		color: #475569;
		line-height: 1.5;
		font-size: 14px;
	}

	h3 {
		margin: 0;
		color: #0f172a;
		font-size: 16px;
		letter-spacing: -0.01em;
	}
</style>
