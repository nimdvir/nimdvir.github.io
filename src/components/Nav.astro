---
import ThemePicker from "./ThemePicker.astro";
const links = [
  { href: "/", label: "Home" },
  { href: "/cv/", label: "CV" },
  { href: "/research/", label: "Research", also: "/projects/" },
  { href: "/teaching/", label: "Teaching" },
  { href: "/media/", label: "Media", also: "/articles/" },
  { href: "/blog/", label: "Blog" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Article pages live under /articles/ but belong to the Media section.
const inSection = (link: (typeof links)[number]) =>
  link.href === "/"
    ? path === "/"
    : path === link.href.replace(/\/$/, "") ||
      path.startsWith(link.href) ||
      ("also" in link && !!link.also && path.startsWith(link.also));
---

<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="Nim Dvir home">
      <img src="/favicon.png" width="30" height="30" alt="" />
      <span>
        Nim Dvir<span class="brand-degree">, PhD</span>
      </span>
    </a>
    <div class="nav-controls">
      <ThemePicker />
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        hidden
      >
        <span>Menu</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
    <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={inSection(link) ? "page" : undefined}
        >
          {link.href === "/" && (
            <svg
              class="home-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" />
            </svg>
          )}
          {link.label}
        </a>
      ))}
      <a
        class="nav-contact"
        href="/contact/"
        aria-current={path === "/contact" ? "page" : undefined}
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  // Sticky menus and side rails sit just under this header.
  const header = document.querySelector<HTMLElement>(".site-header");
  const setHeaderHeight = () =>
    document.documentElement.style.setProperty(
      "--header-h",
      `${header?.offsetHeight ?? 77}px`,
    );
  setHeaderHeight();
  window.addEventListener("resize", setHeaderHeight);
</script>
