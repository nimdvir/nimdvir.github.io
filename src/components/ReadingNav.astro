---
// Reading navigation for long texts (articles, blog posts). Wide screens: a
// rail beside the text with the subheadings as teasers, minutes left and
// "Up next". Narrow screens: a small circle that opens briefly at each new
// subheading and opens the full list on tap. The text element needs
// `data-reading-body`; see "Article formatting" in AGENTS.md.
import type { MarkdownHeading } from "astro";

type Stop = { id: string; text: string };
interface Props {
  headings: MarkdownHeading[];
  questions?: Stop[];
  minutes: number;
  title: string;
  upNext?: { href: string; title: string; name?: string; thumb?: string };
  label?: string;
}
const { headings, questions = [], minutes, title, upNext, label = "In this article" } = Astro.props;

// The text's own subheadings. With fewer than two, up to five of its
// interview questions, spread through the piece, stand in. Nothing is invented.
const subheads: Stop[] = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, text: h.text }));
const spread = (list: Stop[], k: number) =>
  list.length <= k
    ? list
    : Array.from({ length: k }, (_, i) => list[Math.round((i * (list.length - 1)) / (k - 1))]);
const outline =
  subheads.length >= 2 || questions.length < 3 ? subheads : spread(questions, 5);
---

<aside class="article-rail" aria-label={label}>
  <div class="rail-inner">
    <p class="rail-eyebrow">{label}</p>
    <p class="rail-time"><span data-left>{minutes} min</span> left</p>
    <div class="rail-progress" aria-hidden="true"><span data-bar></span></div>
    {outline.length > 0 && (
      <ol class="rail-list">
        {outline.map((o) => (
          <li class="rail-item"><a href={`#${o.id}`}>{o.text}</a></li>
        ))}
      </ol>
    )}
    {upNext && (
      <a class="rail-next" href={upNext.href}>
        <span class="rail-eyebrow">Up next</span>
        {upNext.thumb && <img src={upNext.thumb} alt="" width="640" height="400" loading="lazy" />}
        {upNext.name && <span class="rail-next-name">{upNext.name}</span>}
        <span class="rail-next-title">{upNext.title} →</span>
      </a>
    )}
  </div>
</aside>

{outline.length > 0 ? (
  <div class="chapter-pill" data-pill>
    <button class="pill-button" type="button" aria-expanded="false" aria-controls="pill-panel" aria-label={label}>
      <span class="pill-dot" aria-hidden="true">
        <svg viewBox="0 0 36 36">
          <circle class="pill-track" cx="18" cy="18" r="15" />
          <circle class="pill-ring" cx="18" cy="18" r="15" pathLength="100" data-ring />
        </svg>
        <span class="pill-mark" data-pill-mark>≡</span>
      </span>
      <span class="pill-label" data-pill-label>{title}</span>
    </button>
    <div class="pill-panel" id="pill-panel" hidden>
      <ol class="rail-list">
        {outline.map((o) => (
          <li class="rail-item"><a href={`#${o.id}`}>{o.text}</a></li>
        ))}
      </ol>
      {upNext && (
        <a class="rail-next" href={upNext.href}>
          <span class="rail-eyebrow">Up next</span>
          {upNext.thumb && <img src={upNext.thumb} alt="" width="640" height="400" loading="lazy" />}
          {upNext.name && <span class="rail-next-name">{upNext.name}</span>}
          <span class="rail-next-title">{upNext.title} →</span>
        </a>
      )}
    </div>
  </div>
) : (
  upNext && (
    <div class="chapter-pill" data-pill data-pill-late>
      <a class="pill-button" href={upNext.href}>
        <span class="pill-dot" aria-hidden="true">
          <svg viewBox="0 0 36 36">
            <circle class="pill-track" cx="18" cy="18" r="15" />
            <circle class="pill-ring" cx="18" cy="18" r="15" pathLength="100" data-ring />
          </svg>
          <span class="pill-mark" data-pill-mark>→</span>
        </span>
        <span class="pill-label">Up next: {upNext.name || upNext.title}</span>
      </a>
    </div>
  )
)}

<script>
  // Reading progress and which subheading the reader has reached, for the
  // side rail (wide screens) and the chapter pill (narrow screens). The pill
  // rests as a small circle and opens briefly at each new subheading.
  const body = document.querySelector<HTMLElement>("[data-reading-body]");
  if (body) {
    const minutes = Number(
      document.querySelector("[data-left]")?.textContent?.match(/\d+/)?.[0] ?? 0,
    );
    const lefts = document.querySelectorAll<HTMLElement>("[data-left]");
    const bars = document.querySelectorAll<HTMLElement>("[data-bar]");
    const pill = document.querySelector<HTMLElement>("[data-pill]");
    const ring = pill?.querySelector<SVGCircleElement>("[data-ring]");
    const mark = pill?.querySelector<HTMLElement>("[data-pill-mark]");
    const label = pill?.querySelector<HTMLElement>(".pill-label");
    const late = pill?.hasAttribute("data-pill-late") ?? false;
    const title = label?.textContent ?? "";
    const button = pill?.querySelector<HTMLElement>(".pill-button");
    const panel = pill?.querySelector<HTMLElement>(".pill-panel");
    const lists = [...document.querySelectorAll<HTMLElement>(".rail-list")];
    const first = lists[0] ? [...lists[0].querySelectorAll("a")] : [];
    const targets = first.map((a) =>
      document.getElementById(decodeURIComponent(a.hash.slice(1))),
    );

    let miniTimer = 0;
    const fitLabel = () => {
      if (label) label.style.setProperty("--label-w", `${label.scrollWidth + 2}px`);
    };
    const minimize = (delay: number) => {
      window.clearTimeout(miniTimer);
      miniTimer = window.setTimeout(() => {
        if (!panel || panel.hidden) pill?.classList.add("is-mini");
      }, delay);
    };
    const showBriefly = () => {
      fitLabel();
      pill?.classList.remove("is-mini");
      minimize(2600);
    };
    const setOpen = (open: boolean) => {
      if (!button || !panel) return;
      panel.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      if (open) {
        window.clearTimeout(miniTimer);
        fitLabel();
        pill?.classList.remove("is-mini");
      } else minimize(1200);
    };

    let visible = false;
    let current = -2;
    let queued = false;
    const update = () => {
      queued = false;
      const view = window.innerHeight;
      const top = body.getBoundingClientRect().top + window.scrollY;
      const done = Math.min(
        1,
        Math.max(0, (window.scrollY + view * 0.35 - top) / body.offsetHeight),
      );
      bars.forEach((b) => (b.style.transform = `scaleX(${done})`));
      lefts.forEach(
        (el) => (el.textContent = `${Math.max(0, Math.ceil(minutes * (1 - done)))} min`),
      );
      if (ring) ring.style.strokeDashoffset = `${100 - done * 100}`;
      // Without subheadings the pill only offers what's next, so it waits
      // until the reader is halfway through.
      const show = late ? done > 0.5 : window.scrollY > top - view * 0.6;
      if (show !== visible) {
        visible = show;
        pill?.classList.toggle("is-visible", show);
        if (show) showBriefly();
        else setOpen(false);
      }
      let reached = -1;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top < view * 0.35) reached = i;
      });
      if (reached === current) return;
      const firstRun = current === -2;
      current = reached;
      if (label && !late) {
        label.textContent = reached >= 0 ? first[reached].textContent : title;
        fitLabel();
      }
      if (mark && !late) mark.textContent = reached >= 0 ? `${reached + 1}/${first.length}` : "≡";
      for (const list of lists)
        list.querySelectorAll("li").forEach((li, i) => {
          li.dataset.state = i < reached ? "read" : i === reached ? "current" : "";
          li.querySelector("a")?.toggleAttribute("aria-current", i === reached);
        });
      if (!firstRun && visible && reached >= 0) showBriefly();
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();

    // A tap on the circle opens the full list. On the "Up next" pill, the
    // first tap shows where it goes and the second one follows the link.
    button?.addEventListener("click", (e) => {
      if (late) {
        if (pill?.classList.contains("is-mini")) {
          e.preventDefault();
          showBriefly();
        }
        return;
      }
      setOpen(!!panel?.hidden);
    });
    panel?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (pill && !pill.contains(e.target as Node) && panel && !panel.hidden) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel && !panel.hidden) {
        setOpen(false);
        button?.focus();
      }
    });
  }
</script>
