---
// Blog posts as photo cards (the Blog page and "More to read" on each post).
import type { CollectionEntry } from "astro:content";
import { formatDate, readingMinutes } from "../utils/editorial";
interface Props {
  entries: CollectionEntry<"blog">[];
  headingLevel?: "h2" | "h3";
  columns?: 2 | 3;
}
const { entries, headingLevel = "h3", columns = 2 } = Astro.props;
const Heading = headingLevel;
// Size a plain Cloudinary image for the card; cardImage comes ready-sized.
const sized = (src: string) =>
  src.includes("/image/upload/")
    ? src.replace(
        /\/image\/upload\/(?:[^/]*[a-z]_[^/]*\/)?/,
        "/image/upload/f_auto,q_auto,w_720,h_450,c_fill,g_auto/",
      )
    : src;
---

<ul class:list={["post-cards", { "post-cards-3": columns === 3 }]}>
  {entries.map((post) => {
    const img = post.data.cardImage ?? (post.data.image ? sized(post.data.image) : null);
    return (
      <li class="post-card">
        <a class="post-card-visual" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
          {img ? (
            <img src={img} alt={post.data.imageAlt ?? post.data.title} width="720" height="450" loading="lazy" decoding="async" />
          ) : (
            <span class="post-card-mark">{post.data.title.slice(0, 1)}</span>
          )}
        </a>
        <div class="post-card-body">
          <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
          <Heading>
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
          </Heading>
          <p>{post.data.summary}</p>
          <p class="post-meta">{readingMinutes(post.body)} min read</p>
        </div>
      </li>
    );
  })}
</ul>
