---
import type { Article } from "../utils/articles";
import { articleKindLabel, articleMonogram, articlePortrait } from "../utils/articles";

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  lede?: string;
  articles: Article[];
  tone?: "dark" | "light";
  /** "faces" labels each tile with the person; "stories" with the headline. */
  variant?: "faces" | "stories";
}
const { id, eyebrow, heading, lede, articles, tone = "dark", variant = "faces" } = Astro.props;
const stories = variant === "stories";

const nameOf = (a: Article) =>
  stories ? a.data.title : a.data.interviewee || a.data.subjects[0] || a.data.title;
---

<section class={`face-wall face-wall-${tone}${stories ? " face-wall-stories" : ""}`} id={id} aria-labelledby={`${id}-heading`}>
  <div class="face-wall-head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-heading`}>{heading}</h2>
    {lede && <p class="face-wall-lede">{lede}</p>}
  </div>
  <ul class="face-grid" role="list">
    {articles.map((a) => {
      const d = a.data;
      const portrait = articlePortrait(d.thumb && !d.image ? d.thumb : d.image, 600);
      return (
        <li class="face-tile" data-kind={d.kind}>
          <a href={`/articles/${a.slug}/`} class="face-link">
            <span class="face-visual">
              {portrait ? (
                <img
                  src={portrait}
                  alt={d.imageAlt ?? d.title}
                  loading="lazy"
                  width="600"
                  height="800"
                />
              ) : (
                <span class="face-initials" aria-hidden="true">
                  {articleMonogram(a)}
                </span>
              )}
            </span>
            <span class="face-caption">
              <span class="face-name">{nameOf(a)}</span>
              <span class="face-meta">
                {stories && <span class="face-kind">{articleKindLabel(d.kind)} · </span>}
                <span class="face-source">{d.source} · </span>
                {d.date.slice(0, 4)}
              </span>
              <span class="face-headline">{stories ? d.summary : d.title}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<script>
  // The wall of faces pops in: as a wall scrolls into view, each face springs
  // up from below in a quick cascade, then a streak of light sweeps across
  // it. On phones the face crossing the middle of the screen steps forward;
  // with a mouse, faces tilt toward the pointer. Reduced motion skips it all.
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  const touch = window.matchMedia("(hover: none) and (max-width: 820px)");

  for (const grid of document.querySelectorAll<HTMLElement>(".face-grid")) {
    const tiles = [...grid.querySelectorAll<HTMLElement>(".face-tile")];
    if (calm.matches || !("IntersectionObserver" in window)) continue;

    tiles.forEach((tile, i) => {
      tile.style.setProperty("--tilt", `${i % 2 ? 7 : -7}deg`);
    });
    grid.classList.add("pop-ready");

    const pop = new IntersectionObserver(
      (entries) => {
        const arriving = entries
          .filter((e) => e.isIntersecting)
          .map((e) => e.target as HTMLElement)
          .sort((a, b) => {
            const ra = a.getBoundingClientRect();
            const rb = b.getBoundingClientRect();
            return ra.top - rb.top || ra.left - rb.left;
          });
        arriving.forEach((tile, i) => {
          tile.style.setProperty("--delay", `${Math.min(i, 12) * 70}ms`);
          tile.classList.add("is-in");
          pop.unobserve(tile);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.15 },
    );
    tiles.forEach((tile) => pop.observe(tile));

    if (touch.matches) {
      const spotlight = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            e.target.classList.toggle("is-center", e.isIntersecting);
        },
        // A thin line across the middle of the screen: one row at a time.
        { rootMargin: "-49% 0px -49% 0px" },
      );
      tiles.forEach((tile) => spotlight.observe(tile));
    } else {
      for (const link of grid.querySelectorAll<HTMLElement>(".face-link")) {
        link.addEventListener("pointermove", (event) => {
          const r = link.getBoundingClientRect();
          const x = (event.clientX - r.left) / r.width - 0.5;
          const y = (event.clientY - r.top) / r.height - 0.5;
          link.style.setProperty("--ry", `${(x * 14).toFixed(2)}deg`);
          link.style.setProperty("--rx", `${(-y * 14).toFixed(2)}deg`);
          link.style.setProperty("--gx", `${((x + 0.5) * 100).toFixed(1)}%`);
          link.style.setProperty("--gy", `${((y + 0.5) * 100).toFixed(1)}%`);
        });
        link.addEventListener("pointerleave", () => {
          link.style.removeProperty("--rx");
          link.style.removeProperty("--ry");
        });
      }
    }
  }
</script>
