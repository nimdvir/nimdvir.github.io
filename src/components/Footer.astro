---
import { socialLinks, cvUrl } from "../data/profile";
import ProfileIcon from "./ProfileIcon.astro";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-name" href="/">
        Nim Dvir, PhD
      </a>
      <p>Research. Teaching. Making things useful.</p>
      <p class="small">
        Lecturer · Massry School of Business
        <br />
        University at Albany, SUNY
      </p>
    </div>
    <div>
      <p class="eyebrow">Stay in touch</p>
      <nav class="social-links" aria-label="Social and professional profiles">
        {socialLinks.map((link) => (
          <a class="button" href={link.href}>
            <ProfileIcon icon={link.icon} />
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Nim Dvir</span>
    <a href={cvUrl}>Curriculum vitae · September 2026 ↗</a>
    <a href="https://github.com/nimdvir/cce-2026">
      CCE 2026 session repository ↗
    </a>
  </div>
</footer>
