---
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const { currentSlug, heading = "Other interviews" } = Astro.props;

const interviews = await getCollection("interviews");
const related = interviews.filter(
  (interview) => `interviews/${interview.slug}` !== currentSlug,
);
---

<section class="related" data-base={base}>
  <div class="related-head">
    <h2>{heading}</h2>
    <a class="browse" href={withBase("/media")}>
      All interviews <i class="fas fa-arrow-right"></i>
    </a>
  </div>
  <div class="related-grid" id="related-grid">
    {related.map((interview) => (
      <a
        class="card js-related-card"
        href={withBase(`/interviews/${interview.slug}`)}
      >
        <div class="thumb-wrap">
          {interview.data.image && (
            <img
              src={interview.data.image}
              alt={interview.data.title}
              loading="lazy"
            />
          )}
        </div>
        <div class="card-body">
          <p class="meta">
            <span class="date">
              <i class="far fa-calendar"></i> {interview.data.date}
            </span>
            {interview.data.source && (
              <span class="source">{interview.data.source}</span>
            )}
          </p>
          <h3>{interview.data.title}</h3>
          <div class="tags">
            {interview.data.tags.slice(0, 2).map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const grid = document.getElementById("related-grid");
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll(".js-related-card"));
      if (cards.length <= 3) return;

      const shuffled = [...cards];

      for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [shuffled[index], shuffled[randomIndex]] = [
          shuffled[randomIndex],
          shuffled[index],
        ];
      }

      const selected = shuffled.slice(0, 3);
      cards.forEach((card) => {
        card.style.display = "none";
      });

      selected.forEach((card) => {
        card.style.display = "flex";
        grid.appendChild(card);
      });
    });
  </script>
</section>
